#!/usr/bin/env python3
"""feature-map -- draw what a tool does as one picture, from a plain outline.

A tool that keeps growing is hard to hold in your head. Its README lists every
flag, and nobody reads a README to find out what the thing is for. A feature map
is the other view: every capability, grouped by the job it does, around the
tool's name, with the things it does not do yet drawn in dashes beside the rest.

The picture is only worth having while it is true, so the outline it is drawn
from says where its list came from, and that source is printed on the map. A
map with no source is refused, and so is one that names the same feature twice.

Usage:
    feature-map render SPEC [-o OUT] [--format svg|html|png|mermaid]
    feature-map check SPEC          validate the outline and print what it holds
    feature-map draft help|make SOURCE --title T    draft an outline from help text or a Makefile
    feature-map drift SPEC help|make SOURCE         what the tool has that the map does not show
    feature-map stack COMPOSE_JSON [-o OUT]         draw a Docker Compose stack (experimental)
    feature-map --version

SPEC is a Markdown outline (see docs/format.md) or the same thing as JSON.
Without -o, svg and mermaid go to stdout. The format follows OUT's extension
unless --format says otherwise. png needs a Chromium-based browser on PATH, or
its path in FEATURE_MAP_BROWSER.

SOURCE is a file, or - to read standard input: `mytool --help | feature-map
draft help - --title Mytool`. Nothing is ever run on your behalf.

Exit codes: 0 done (drift: nothing drifted), 1 the outline is invalid or has
drifted, 2 bad usage, 3 png failed.
"""

import argparse
import html
import json
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
import textwrap
from pathlib import Path

VERSION = "0.3.0"

PALETTE = ["#2563eb", "#16a34a", "#d97706", "#7c3aed", "#0d9488", "#db2777", "#4f46e5", "#ca8a04"]
PLANNED = "#b91c1c"

# Layout constants, in SVG pixels. The character widths are estimates for the
# fonts below; a wrong estimate makes a pill a little wide, never overlapping.
PILL_WRAP = 34
CHAR_W = 7.4
HEAD_CHAR_W = 8.6
LINE_H = 19
PILL_PAD = 18
PILL_GAP = 12
GROUP_GAP = 60
RX = 380
PILL_OFFSET = 190
TOP = 300


class SpecError(ValueError):
    """The outline cannot be drawn truthfully."""


# --- reading the outline -----------------------------------------------------

KEY_RE = re.compile(r"^([a-z][a-z-]*):\s*(.*)$")
TAG_RE = re.compile(r"\s*\[planned\]\s*$", re.IGNORECASE)
HEAD_RE = re.compile(r"^\*\*(.+?)\*\*:?\s*(.*)$")


def parse_markdown(text):
    """Turn the outline into a spec dict. Unknown lines are an error, not ignored."""
    spec = {"lede": [], "groups": []}
    group = None
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.rstrip()
        if not line.strip():
            continue
        if line.startswith("# "):
            spec["title"] = line[2:].strip()
        elif line.startswith("> "):
            spec["subtitle"] = line[2:].strip()
        elif line.startswith("## "):
            name = line[3:].strip()
            planned = bool(TAG_RE.search(name))
            group = {"name": TAG_RE.sub("", name), "planned": planned, "items": []}
            spec["groups"].append(group)
        elif line.lstrip().startswith("- "):
            if group is None:
                raise SpecError(f"line {n}: an item before any '## group'")
            body = line.lstrip()[2:].strip()
            planned = bool(TAG_RE.search(body))
            body = TAG_RE.sub("", body)
            item = {"text": body, "planned": planned}
            m = HEAD_RE.match(body)
            if m:
                item = {"head": m.group(1), "text": m.group(2), "planned": planned}
            group["items"].append(item)
        elif group is None and KEY_RE.match(line):
            key, value = KEY_RE.match(line).groups()
            spec[key.replace("-", "_")] = value.strip()
        elif group is None:
            spec["lede"].append(line.strip())
        else:
            raise SpecError(f"line {n}: not an item, a group or a setting: {line.strip()!r}")
    return spec


def load(path):
    text = Path(path).read_text(encoding="utf-8")
    spec = json.loads(text) if str(path).endswith(".json") else parse_markdown(text)
    return normalise(spec)


def normalise(spec):
    """Fill defaults and refuse a map that would not be true."""
    if not spec.get("title"):
        raise SpecError("the outline has no '# title'")
    if not spec.get("source"):
        raise SpecError("the outline has no 'source:' line; a map says where its list came from")
    groups = spec.get("groups") or []
    if not groups:
        raise SpecError("the outline has no '## group'")
    seen = {}
    for gi, g in enumerate(groups):
        g.setdefault("planned", False)
        if not g.get("items"):
            raise SpecError(f"group {g.get('name')!r} has no items")
        for it in g["items"]:
            if isinstance(it, str):
                it = {"text": it}
            label = ((it.get("head") or "") + " " + it.get("text", "")).strip().lower()
            if label in seen:
                raise SpecError(f"{label!r} appears twice, under {seen[label]!r} and {g['name']!r}")
            seen[label] = g["name"]
        g["items"] = [({"text": i} if isinstance(i, str) else i) for i in g["items"]]
        g.setdefault("color", PLANNED if g["planned"] else PALETTE[gi % len(PALETTE)])
    spec.setdefault("subtitle", "")
    spec.setdefault("center", spec["title"])
    spec.setdefault("center_sub", "")
    spec.setdefault("date", "")
    spec.setdefault("planned_label", "not done yet")
    omit = spec.get("omit") or []
    spec["omit"] = [o.strip() for o in (omit.split(",") if isinstance(omit, str) else omit) if o.strip()]
    lede = spec.get("lede") or []
    spec["lede"] = textwrap.wrap(" ".join(lede), 52) if isinstance(lede, list) else textwrap.wrap(lede, 52)
    return spec


# --- layout ------------------------------------------------------------------

def wrap(text, width=PILL_WRAP):
    return textwrap.wrap(text, width) or [text or " "]


def pill_size(item):
    lines = wrap(item["text"]) if item.get("text") else []
    head = item.get("head")
    width = max([len(line) * CHAR_W for line in lines] + [len(head) * HEAD_CHAR_W if head else 0]) + 34
    height = (LINE_H if head else 0) + len(lines) * LINE_H + PILL_PAD
    return width, height


def layout(spec):
    """Place every group and pill. Returns geometry only; drawing is separate,
    so the tests can check that nothing overlaps without rendering anything."""
    groups = spec["groups"]
    planned = [g for g in groups if g["planned"]]
    shipped = [g for g in groups if not g["planned"]]
    bottom = planned[:1]
    sides = shipped + planned[1:]
    def stack_height(g):
        return sum(pill_size(i)[1] for i in g["items"]) + PILL_GAP * (len(g["items"]) - 1)

    def column_height(col):
        return sum(stack_height(g) for g in col) + GROUP_GAP * max(len(col) - 1, 0)

    # Split the groups, in order, where the two columns come out closest in
    # height, so a map with one crowded group does not lean to one side.
    half = min(range(len(sides) + 1),
               key=lambda k: (max(column_height(sides[:k]), column_height(sides[k:])), abs(2 * k - len(sides))))
    left, right = sides[:half], sides[half:]

    heights = [column_height(left), column_height(right)]
    rows = math.ceil(len(bottom[0]["items"]) / 3) if bottom else 0
    body = max(heights + [360])
    height = int(TOP + body + (140 + rows * 78 + 60 if bottom else 60) + 80)
    widest = max([pill_size(i)[0] for g in groups for i in g["items"]] + [200])
    width = int(max(1800, 2 * (RX + PILL_OFFSET + widest + 60)))
    cx, cy = width / 2, TOP + body / 2

    placed, pills = [], []
    for side, col, total in ((-1, left, heights[0]), (1, right, heights[1])):
        y = cy - total / 2
        for g in col:
            st = stack_height(g)
            gx, gy = cx + side * RX, y + st / 2
            placed.append({"group": g, "x": gx, "y": gy, "side": side})
            yy = y
            px = cx + side * (RX + PILL_OFFSET)
            for it in g["items"]:
                w, h = pill_size(it)
                x = px if side > 0 else px - w
                pills.append({"item": it, "group": g, "x": x, "y": yy, "w": w, "h": h, "side": side, "gx": gx, "gy": gy})
                yy += h + PILL_GAP
            y += st + GROUP_GAP
    for g in bottom:
        gx, gy = cx, TOP + body + 70
        placed.append({"group": g, "x": gx, "y": gy, "side": 0})
        k = len(g["items"])
        for idx, it in enumerate(g["items"]):
            r, c = divmod(idx, 3)
            cnt = min(3, k - r * 3)
            w, h = pill_size(it)
            px = gx + (c - (cnt - 1) / 2) * 300
            py = gy + 100 + r * 78
            pills.append({"item": it, "group": g, "x": px - w / 2, "y": py - h / 2, "w": w, "h": h, "side": 0, "gx": gx, "gy": gy})
    return {"width": width, "height": height, "cx": cx, "cy": cy, "groups": placed, "pills": pills}


# --- drawing -----------------------------------------------------------------

FONTS = "https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Inter:wght@400;500;700&display=swap"

STYLE = """
.tt{font:600 58px 'Fraunces',Georgia,serif;fill:#1f2a37}
.st{font:400 26px 'Fraunces',Georgia,serif;fill:#1f2a37}
.lede{font:400 19px 'Inter',system-ui,sans-serif;fill:#4b5563}
.ph{font:700 15px 'Inter',system-ui,sans-serif}
.pt{font:500 14.5px 'Inter',system-ui,sans-serif;fill:#1f2937}
.gt{font:700 20px 'Inter',system-ui,sans-serif}
.ct{font:700 22px 'Fraunces',Georgia,serif;fill:#fff}
.cs{font:500 12px 'Inter',system-ui,sans-serif;fill:#cbd5e1}
.ft{font:500 13px 'Inter',system-ui,sans-serif;fill:#6b7280;letter-spacing:.14em}
.lg{font:500 14px 'Inter',system-ui,sans-serif;fill:#374151}
"""


def esc(text):
    return html.escape(str(text), quote=True)


def dash(on, pattern):
    return f' stroke-dasharray="{pattern}"' if on else ""


def svg(spec):
    geo = layout(spec)
    W, H, cx, cy = geo["width"], geo["height"], geo["cx"], geo["cy"]
    out = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}" role="img">',
           f"<title>{esc(spec['title'])} feature map</title>", f"<style>{STYLE}</style>",
           f'<rect width="{W}" height="{H}" fill="#f7f5ef"/>',
           f'<text x="60" y="92" class="tt">{esc(spec["title"])}</text>',
           f'<text x="62" y="130" class="st">{esc(spec["subtitle"])}</text>']
    out += [f'<text x="62" y="{172 + i * 26}" class="lede">{esc(line)}</text>' for i, line in enumerate(spec["lede"])]
    out.append(f'<g transform="translate({W - 330},60)">'
               '<rect width="16" height="16" rx="8" fill="#6b7280"/><text x="26" y="13" class="lg">shipped and in use</text>'
               f'<rect y="30" width="16" height="16" rx="8" fill="#fff" stroke="{PLANNED}" stroke-width="1.6" stroke-dasharray="4 3"/>'
               f'<text x="26" y="43" class="lg">{esc(spec["planned_label"])}</text></g>')
    for g in geo["groups"]:
        col, neg = g["group"]["color"], g["group"]["planned"]
        mx = (cx + g["x"]) / 2 + (g["y"] - cy) * 0.15
        my = (cy + g["y"]) / 2 - (g["x"] - cx) * 0.15
        out.append(f'<path d="M{cx:.1f},{cy:.1f} Q{mx:.1f},{my:.1f} {g["x"]:.1f},{g["y"]:.1f}" stroke="{col}" '
                   f'stroke-width="{4 if neg else 7}" fill="none" stroke-linecap="round" opacity=".85"{dash(neg, "10 8")}/>')
    for p in geo["pills"]:
        col = p["group"]["color"]
        neg = p["group"]["planned"] or p["item"].get("planned")
        side = p["side"]
        if side:
            ex, ey = p["gx"] + side * 95, p["gy"]
            px, py = (p["x"] if side > 0 else p["x"] + p["w"]), p["y"] + p["h"] / 2
            mid = (ex + px) / 2
            d = f"M{ex:.1f},{ey:.1f} C{mid:.1f},{ey:.1f} {mid:.1f},{py:.1f} {px:.1f},{py:.1f}"
        else:
            ex, ey = p["gx"], p["gy"] + 24
            px, py = p["x"] + p["w"] / 2, p["y"]
            d = f"M{ex:.1f},{ey:.1f} C{ex:.1f},{(ey + py) / 2:.1f} {px:.1f},{(ey + py) / 2:.1f} {px:.1f},{py:.1f}"
        out.append(f'<path d="{d}" stroke="{PLANNED if neg else col}" stroke-width="2.2" fill="none" opacity=".7"{dash(neg, "6 5")}/>')
    for p in geo["pills"]:
        col = PLANNED if (p["group"]["planned"] or p["item"].get("planned")) else p["group"]["color"]
        neg = col == PLANNED
        r = p["h"] / 2 if p["h"] < 50 else 18
        out.append(f'<rect x="{p["x"]:.1f}" y="{p["y"]:.1f}" width="{p["w"]:.1f}" height="{p["h"]:.1f}" rx="{r:.1f}" '
                   f'fill="#fff" stroke="{col}" stroke-width="1.6"{dash(neg, "5 4")}/>')
        out.append(f'<rect x="{p["x"]:.1f}" y="{p["y"]:.1f}" width="{p["w"]:.1f}" height="{p["h"]:.1f}" rx="{r:.1f}" fill="{col}" fill-opacity=".13"/>')
        ty, mx = p["y"] + 22, p["x"] + p["w"] / 2
        if p["item"].get("head"):
            out.append(f'<text x="{mx:.1f}" y="{ty:.1f}" text-anchor="middle" class="ph" fill="{col}">{esc(p["item"]["head"])}</text>')
            ty += LINE_H
        if p["item"].get("text"):
            for line in wrap(p["item"]["text"]):
                out.append(f'<text x="{mx:.1f}" y="{ty:.1f}" text-anchor="middle" class="pt">{esc(line)}</text>')
                ty += LINE_H
    for g in geo["groups"]:
        col, neg = g["group"]["color"], g["group"]["planned"]
        lines = wrap(g["group"]["name"], 16)
        w, h = max(len(line) for line in lines) * 10.5 + 48, len(lines) * 24 + 34
        out.append(f'<rect x="{g["x"] - w / 2:.1f}" y="{g["y"] - h / 2:.1f}" width="{w:.1f}" height="{h:.1f}" rx="{h / 2:.1f}" '
                   f'fill="{"#fff" if neg else col}" stroke="{col}" stroke-width="3"{dash(neg, "8 6")}/>')
        for i, line in enumerate(lines):
            out.append(f'<text x="{g["x"]:.1f}" y="{g["y"] - h / 2 + 30 + i * 24:.1f}" text-anchor="middle" class="gt" '
                       f'fill="{col if neg else "#fff"}">{esc(line)}</text>')
    r = 100
    hexagon = " ".join(f"{cx + r * math.cos(math.radians(60 * i - 30)):.1f},{cy + r * math.sin(math.radians(60 * i - 30)):.1f}" for i in range(6))
    out.append(f'<polygon points="{hexagon}" fill="#1f2a37"/>')
    out.append(f'<text x="{cx:.1f}" y="{cy - 2:.1f}" text-anchor="middle" class="ct">{esc(spec["center"])}</text>')
    for i, line in enumerate(s for s in spec["center_sub"].split(" · ") if s):
        out.append(f'<text x="{cx:.1f}" y="{cy + 24 + i * 16:.1f}" text-anchor="middle" class="cs">{esc(line)}</text>')
    footer = "DRAWN FROM " + spec["source"] + (f"  ·  {spec['date']}" if spec["date"] else "")
    out.append(f'<text x="{W / 2:.1f}" y="{H - 28}" text-anchor="middle" class="ft">{esc(footer.upper())}</text>')
    out.append("</svg>")
    return "\n".join(out) + "\n"


def page(spec):
    return (f'<!doctype html><html><head><meta charset="utf-8"><title>{esc(spec["title"])} feature map</title>'
            f'<link rel="stylesheet" href="{FONTS}"></head><body style="margin:0;background:#f7f5ef">{svg(spec)}</body></html>\n')


def mermaid(spec):
    """The same map as a Mermaid tree, for a Markdown page that renders it."""
    def q(text):
        return text.replace('"', "'").replace("[", "(").replace("]", ")")
    out = ["flowchart LR", f'  R(["{q(spec["title"])}"])']
    n = 0
    for gi, g in enumerate(spec["groups"], 1):
        out.append(f'  R --> G{gi}["{q(g["name"])}"]')
        out.append(f"  class G{gi} {'nogrp' if g['planned'] else 'grp'}")
        for it in g["items"]:
            n += 1
            label = (f"{it['head']}: " if it.get("head") else "") + it.get("text", "")
            out.append(f'  G{gi} --- N{n}["{q(label)}"]')
            if g["planned"] or it.get("planned"):
                out.append(f"  class N{n} no")
    out += ["  classDef grp font-weight:bold",
            f"  classDef nogrp font-weight:bold,fill:#fbe3e3,stroke:{PLANNED}",
            f"  classDef no fill:#fdf0f0,stroke:{PLANNED},stroke-dasharray:4 3"]
    return "\n".join(out) + "\n"


# --- png ---------------------------------------------------------------------

def write_output(body, width, height, title, output):
    """svg, html or png, by the output's extension; svg to stdout without one."""
    fmt = Path(output).suffix.lstrip(".") if output else "svg"
    html_page = (f'<!doctype html><html><head><meta charset="utf-8"><title>{esc(title)}</title>'
                 f'<link rel="stylesheet" href="{FONTS}"></head><body style="margin:0;background:#f7f5ef">{body}</body></html>\n')
    if fmt == "png":
        try:
            screenshot(html_page, width, height, output)
        except (RuntimeError, subprocess.TimeoutExpired) as exc:
            print(f"feature-map: {exc}", file=sys.stderr)
            return 3
        return 0
    text = html_page if fmt == "html" else body
    if output:
        Path(output).write_text(text, encoding="utf-8")
    else:
        sys.stdout.write(text)
    return 0


def browser():
    found = os.environ.get("FEATURE_MAP_BROWSER")
    for name in ([found] if found else []) + ["chromium", "chromium-browser", "google-chrome", "google-chrome-stable"]:
        path = shutil.which(name) if name else None
        if path:
            return path
    return None


def screenshot(html_page, width, height, out):
    exe = browser()
    if not exe:
        raise RuntimeError("png needs a Chromium-based browser on PATH, or FEATURE_MAP_BROWSER set")
    out = Path(out).resolve()
    # Written beside the output, not in /tmp: a sandboxed browser may not see /tmp.
    with tempfile.TemporaryDirectory(dir=out.parent, prefix=".feature-map-") as tmp:
        src = Path(tmp) / "map.html"
        src.write_text(html_page, encoding="utf-8")
        cmd = [exe, "--headless=new", "--disable-gpu", "--hide-scrollbars", "--virtual-time-budget=8000",
               f"--window-size={width},{height}", f"--screenshot={out}", src.as_uri()]
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=120, check=False)
    if result.returncode != 0 or not out.exists():
        raise RuntimeError(f"the browser did not write {out.name}: {result.stderr.strip()[-300:]}")


def png(spec, out):
    geo = layout(spec)
    screenshot(page(spec), geo["width"], geo["height"], out)


# --- reading a tool's own description: draft and drift ------------------------

# A help line names a command, then its description after two or more spaces:
#   "  up                     Start everything". A deeper-indented line with no
# gap is the previous description continuing onto the next line.
HELP_CMD_RE = re.compile(r"^(\s{1,8})(\S(?:.*?\S)?)\s{2,}(\S.*)$")
HELP_BARE_RE = re.compile(r"^(\s{1,8})([a-z][\w:|.-]*)((?:\s+[\[<A-Z-].*)?)$")
MAKE_RE = re.compile(r"^([A-Za-z0-9_.-]+):[^=]*?##\s*(.+)$")


def read_help(text):
    """Commands grouped under the help text's own headings, in order.

    Returns [(heading, [(name, description)])]. A heading is an unindented line
    that is not a usage line; commands before any heading go under 'Commands'."""
    groups, current, skipping = [], None, False
    for raw in text.splitlines():
        line = raw.rstrip()
        if not line.strip():
            continue
        if not line[0].isspace():
            # A usage, options, exit-code or environment section lists things
            # that are not commands, so everything under it is skipped.
            skipping = line.lower().startswith(("usage", "options", "flags", "exit", "environment"))
            current = None if skipping else (line.strip().rstrip(":"), [])
            if current:
                groups.append(current)
            continue
        if skipping:
            continue
        m = HELP_CMD_RE.match(line)
        if not m:
            m2 = HELP_BARE_RE.match(line)
            if m2 and current is not None:
                current[1].append([command_name(m2.group(2) + m2.group(3)), ""])
            elif current is not None and current[1]:
                current[1][-1][1] = (current[1][-1][1] + " " + line.strip()).strip()
            continue
        if current is None:
            current = ("Commands", [])
            groups.append(current)
        current[1].append([command_name(m.group(2)), m.group(3).strip()])
    return [(h, [tuple(c) for c in cmds]) for h, cmds in groups if cmds]


def command_name(usage):
    """The command in a usage fragment: 'scale [web=N] [-y]' is 'scale'."""
    words = []
    for word in usage.split():
        if word[0] in "[<-" or word.isupper() or "=" in word:
            break
        words.append(word)
    return " ".join(words) or usage.split()[0]


def read_make(text):
    """Targets documented with a '## description' comment, the self-documenting
    Makefile convention, under one 'Make targets' group."""
    cmds = [(m.group(1), m.group(2).strip()) for m in map(MAKE_RE.match, text.splitlines()) if m]
    return [("Make targets", cmds)] if cmds else []


def read_source(kind, path):
    text = sys.stdin.read() if path == "-" else Path(path).read_text(encoding="utf-8")
    return read_help(text) if kind == "help" else read_make(text)


def draft(groups, title, source):
    """An outline to curate, never to publish as it is: every command becomes an
    item, and the person drawing the map regroups, trims and declares omissions."""
    out = [f"# {title}", "> TODO: one line on what it is for", "",
           f"source: {source}", f"date: {__import__('datetime').date.today().isoformat()}", ""]
    for heading, cmds in groups:
        out.append(f"## {heading}")
        for name, desc in cmds:
            first = re.split(r"(?<=[.;,])\s", desc, maxsplit=1)[0].rstrip(".;,")
            out.append(f"- **{name}**: {first[:1].lower() + first[1:]}" if first else f"- **{name}**")
        out.append("")
    return "\n".join(out)


def names_on_map(spec):
    """Every command a map's bold names cover. 'up and down' covers up and down;
    'ps, logs and info' covers all three; 'node|npm' covers both."""
    covered = set()
    for g in spec["groups"]:
        for it in g["items"]:
            if it.get("head"):
                for part in re.split(r",\s*|\s+and\s+|\|", it["head"]):
                    if part.strip():
                        covered.add(part.strip().lower())
    return covered


def alternatives(name):
    """'scale refresh|reseed' is two commands, 'scale refresh' and 'scale
    reseed'; 'node|npm' is 'node' and 'npm'. A '<placeholder>' is not a name."""
    if name.startswith("<"):
        return []
    words = name.split()
    last = words[-1].split("|") if words else []
    return [" ".join(words[:-1] + [w]).strip() for w in last if w]


def drift(spec, groups):
    """What the source has that the map neither shows nor declares, and what the
    map names that the source no longer has. Planned items are exempt from the
    second list, since a planned feature is not in the source yet by definition."""
    source = {}
    for _, cmds in groups:
        for name, _ in cmds:
            for alt in alternatives(name.lower()):
                source[alt] = name
    shown = names_on_map(spec)
    omitted = {o.strip().lower() for o in spec.get("omit", [])}
    missing = sorted(n for n in source if n not in shown and n not in omitted and source[n].lower() not in omitted)
    planned = {p.strip().lower() for g in spec["groups"] for it in g["items"] if it.get("head") and (g["planned"] or it.get("planned"))
               for p in re.split(r",\s*|\s+and\s+|\|", it["head"])}
    stale = sorted(n for n in shown if n not in source and n not in planned and not any(n in full.lower() for full in source.values()))
    return missing, stale


# --- stack: a Compose file drawn as boxes and paths -------------------------

VAR_RE = re.compile(r"\$\{[A-Za-z_][A-Za-z0-9_]*(?::?-([^}]*))?\}")


def plain(text):
    """'${HTTP_PORT:-8080}' reads as its default, '8080'; a variable with no
    default stays a variable name, since the real value is not ours to show."""
    return VAR_RE.sub(lambda m: m.group(1) if m.group(1) is not None else "$" + m.group(0)[2:-1].split(":")[0], str(text))


def port_label(p):
    if isinstance(p, dict):
        pub, target = p.get("published"), p.get("target")
        return f"{plain(pub)} \u2192 {target}" if pub else str(target)
    parts = plain(p).rsplit(":", 2)
    return f"{parts[-2]} \u2192 {parts[-1]}" if len(parts) >= 2 else parts[-1]


def image_label(svc):
    if svc.get("build") and not svc.get("image"):
        return "built here"
    img = plain(svc.get("image", "built here"))
    name = img.split("/")[-1]
    return name if len(name) <= 30 else name[:29] + "\u2026"


def read_compose(text):
    """Docker Compose's resolved form, as `docker compose config --format json`
    prints it. JSON only: no YAML parser is needed, and the tool runs nothing."""
    c = json.loads(text)
    services = c.get("services") or {}
    if not services:
        raise SpecError("no services in that Compose configuration")
    out = {}
    for name, svc in services.items():
        nets = svc.get("networks")
        nets = list(nets.keys()) if isinstance(nets, dict) else (nets or ["default"])
        vols = []
        for v in svc.get("volumes") or []:
            if isinstance(v, dict) and v.get("type") == "volume" and v.get("source"):
                vols.append(v["source"])
        deps = svc.get("depends_on") or {}
        out[name] = {
            "image": image_label(svc),
            "networks": nets,
            "ports": [port_label(p) for p in svc.get("ports") or []],
            "volumes": vols,
            "depends": list(deps.keys()) if isinstance(deps, dict) else list(deps),
            "health": "healthcheck" in svc and not (svc["healthcheck"] or {}).get("disable"),
            "profiles": svc.get("profiles") or [],
        }
    nets = {k: bool((v or {}).get("external")) for k, v in (c.get("networks") or {}).items()}
    return {"name": c.get("name", ""), "services": out, "networks": nets}


def stack_columns(names, svcs):
    """Left to right along the request path, returned with the data column.

    The entry is what publishes a port and depends on something; the services
    it reaches follow its paths. The last column holds the data stores: what is
    depended on, depends on nothing, and is used by a service that needs several
    things at once. A service off the path sits with a service it shares a
    volume with, since a shared socket or code volume puts two containers in
    the same tier."""
    depended = {d for n in names for d in svcs[n]["depends"] if d in names}
    entries = [n for n in names if svcs[n]["ports"] and svcs[n]["depends"] and n not in depended]
    depth = {n: 0 for n in entries}
    frontier = list(entries)
    while frontier:
        nxt = []
        for n in frontier:
            for d in svcs[n]["depends"]:
                if d in names and depth.get(d, -1) < depth[n] + 1:
                    depth[d] = depth[n] + 1
                    nxt.append(d)
        frontier = nxt
    # A data store is depended on, depends on nothing, and is used by at least
    # one service that needs several things at once. A single next hop, like
    # the web server behind a cache, stays on the path even though nothing
    # comes after it.
    sinks = [n for n in names if n in depended and not [d for d in svcs[n]["depends"] if d in names]
             and any(n in svcs[m]["depends"] and len([d for d in svcs[m]["depends"] if d in names]) >= 2 for m in names)]
    for n in sinks:
        depth.pop(n, None)
    for n in names:
        if n in depth or n in sinks:
            continue
        mates = [m for m in depth if set(svcs[m]["volumes"]) & set(svcs[n]["volumes"])]
        depth[n] = max((depth[m] for m in mates), default=max(depth.values(), default=-1) + 1)
    cols = {}
    for n in names:
        if n not in sinks:
            cols.setdefault(depth[n], []).append(n)
    ordered = [cols[k] for k in sorted(cols)]
    return ordered, sinks


CARD_W, CARD_GAP, COL_GAP = 250, 18, 110


def card_height(svc):
    return 58 + (22 if svc["ports"] else 0) + (22 if svc["volumes"] else 0)


def stack_svg(model, title, subtitle, source, date):
    svcs = model["services"]
    multi_net = len([n for n in model["networks"] if n]) > 1
    if multi_net:
        boxes = [(f"network: {n}", [s for s in svcs if svcs[s]["networks"][0] == n], model["networks"][n]) for n in model["networks"]]
    else:
        boxes = [("always running", [s for s in svcs if not svcs[s]["profiles"]], False)]
        for prof in sorted({p for s in svcs.values() for p in s["profiles"]}):
            boxes.append((f"opt-in profile: {prof}", [s for s in svcs if svcs[s]["profiles"] and svcs[s]["profiles"][0] == prof], True))
    boxes = [b for b in boxes if b[1]]

    pos, frames, buses = {}, [], []
    y = TOP - 40
    main_w = 0
    row_x, row_h = 60, 0
    for bi, (label, names, dashed) in enumerate(boxes):
        if bi == 0 or multi_net:
            cols, sinks = stack_columns(names, svcs)
            if sinks:
                cols = cols + [sinks]
        else:
            per = min(4, len(names))
            cols, sinks = [names[i::per] for i in range(per)], []
        heights = [sum(card_height(svcs[n]) + CARD_GAP for n in col) - CARD_GAP for col in cols]
        bw = len(cols) * CARD_W + (len(cols) - 1) * COL_GAP + 80
        bh = max(heights) + 90
        if bi == 0 or multi_net:
            bx, by = 60, y
            y += bh + 50
        else:
            # Opt-in boxes flow in a row under the main box, wrapping when full.
            if row_x + bw > max(main_w, 1500) + 60 and row_x > 60:
                row_x, y = 60, y + row_h + 40
                row_h = 0
            bx, by = row_x, y
            row_x += bw + 40
            row_h = max(row_h, bh)
        main_w = max(main_w, bx - 60 + bw)
        frames.append((bx, by, bw, bh, label, dashed))
        for ci, col in enumerate(cols):
            # The main path is centred so it reads as one line; opt-in boxes
            # are top-aligned, since they are lists rather than a path.
            centred = bi == 0 or multi_net
            cy = by + 60 + ((max(heights) - heights[ci]) / 2 if centred else 0)
            for n in col:
                h = card_height(svcs[n])
                pos[n] = (bx + 40 + ci * (CARD_W + COL_GAP), cy, CARD_W, h, dashed)
                cy += h + CARD_GAP
        if sinks:
            first = pos[sinks[0]]
            last = pos[sinks[-1]]
            buses.append((set(sinks), first[0] - 34, first[1], last[1] + last[3]))
    y += row_h + (50 if row_h else 0)
    W = int(max(1800, main_w + 120))
    H = int(y + 80)

    def anchor(n, side):
        x, yy, w, h, _ = pos[n]
        return (x + w, yy + h / 2) if side == "r" else (x, yy + h / 2)

    def curve(x1, y1, x2, y2):
        mid = (x1 + x2) / 2
        return (f'<path d="M{x1:.1f},{y1:.1f} C{mid:.1f},{y1:.1f} {mid:.1f},{y2:.1f} {x2 - 6:.1f},{y2:.1f}" '
                'stroke="#475569" stroke-width="1.8" fill="none" opacity=".75" marker-end="url(#arr)"/>')

    main_bottom = frames[0][1] + frames[0][3] if frames else 0

    def route(points):
        d = "M" + " L".join(f"{x:.1f},{y:.1f}" for x, y in points)
        return (f'<path d="{d}" stroke="#475569" stroke-width="1.8" fill="none" opacity=".75" '
                'stroke-linejoin="round" marker-end="url(#arr)"/>')

    def climb(n, x2, y2, up_into=False):
        """An edge from a box below the main one never passes behind a card:
        it rises to the gap under the main box, runs along it, climbs the gutter
        beside the target's column, and turns into the target."""
        x, yy, w, _, _ = pos[n]
        lane = main_bottom + 22
        # Leave from the right of the card, clear of its box's label above it.
        x1 = x + w - 40
        if up_into:
            return route([(x1, yy), (x1, lane), (x2, lane), (x2, y2 + 6)])
        gutter = x2 - COL_GAP / 2
        return route([(x1, yy), (x1, lane), (gutter, lane), (gutter, y2), (x2 - 6, y2)])

    def below(n, d):
        return pos[n][1] > pos[d][1] + pos[d][3] + 40

    edges = []
    for members, bus_x, top, bottom in buses:
        edges.append(f'<path d="M{bus_x:.1f},{top + 10:.1f} L{bus_x:.1f},{bottom - 10:.1f}" stroke="#475569" stroke-width="3" stroke-linecap="round" opacity=".55"/>')
        for m in members:
            _, yy, _, h, _ = pos[m]
            edges.append(f'<path d="M{bus_x:.1f},{yy + h / 2:.1f} L{pos[m][0] - 6:.1f},{yy + h / 2:.1f}" stroke="#475569" stroke-width="1.8" opacity=".75" marker-end="url(#arr)"/>')
    for n, svc in svcs.items():
        if n not in pos:
            continue
        deps = [d for d in svc["depends"] if d in pos]
        for members, bus_x, top, bottom in buses:
            hit = [d for d in deps if d in members]
            # Three or more arrows into the data column become one arrow into its bus.
            if len(hit) >= 3:
                x1, y1 = anchor(n, "r")
                target_y = min(max(y1, top + 20), bottom - 20)
                edges.append(climb(n, bus_x, bottom - 4, up_into=True) if pos[n][1] > bottom + 40 else curve(x1, y1, bus_x + 6, target_y))
                deps = [d for d in deps if d not in members]
        for d in deps:
            if below(n, d):
                x2, y2 = anchor(d, "l")
                edges.append(climb(n, x2, y2))
                continue
            (x1, y1), (x2, y2) = anchor(n, "r"), anchor(d, "l")
            if x2 < x1:
                (x1, y1), (x2, y2) = anchor(n, "l"), anchor(d, "r")
            edges.append(curve(x1, y1, x2, y2))
    shared = {}
    for n, svc in svcs.items():
        for v in svc["volumes"]:
            shared.setdefault(v, []).append(n)
    vol_colors = {v: PALETTE[i % len(PALETTE)] for i, v in enumerate(sorted(v for v, u in shared.items() if len(u) > 1))}

    out = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}" role="img">',
           f"<title>{esc(title)} stack</title>", f"<style>{STYLE}.cn{{font:700 16px 'Inter',system-ui,sans-serif;fill:#1f2937}}.ci{{font:500 12.5px 'Inter',system-ui,sans-serif;fill:#6b7280}}.tag{{font:600 12px 'Inter',system-ui,sans-serif}}.bl{{font:700 13px 'Inter',system-ui,sans-serif;letter-spacing:.08em}}</style>",
           '<defs><marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#475569"/></marker></defs>',
           f'<rect width="{W}" height="{H}" fill="#f7f5ef"/>',
           f'<text x="60" y="92" class="tt">{esc(title)}</text>',
           f'<text x="62" y="130" class="st">{esc(subtitle)}</text>']
    lx = W - 420
    out.append(f'<g transform="translate({lx},48)">'
               '<path d="M0,8 L34,8" stroke="#475569" stroke-width="1.8" marker-end="url(#arr)"/><text x="46" y="13" class="lg">depends on</text>'
               '<rect x="0" y="28" width="34" height="16" rx="4" fill="#7c3aed" fill-opacity=".16"/><text x="46" y="41" class="lg">same colour: a volume shared between services</text>'
               '<rect x="0" y="56" width="34" height="18" rx="6" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="6 4"/><text x="46" y="70" class="lg">'
               + ("external network" if multi_net else "runs only when its profile is asked for") + "</text>"
               '<circle cx="17" cy="94" r="5" fill="#16a34a"/><text x="46" y="99" class="lg">has a health check</text></g>')
    if not multi_net:
        net = next(iter(model["networks"]), "default")
        out.append(f'<text x="62" y="172" class="lede">One network ({esc(net)}), so the boxes are Compose profiles.</text>')
    for bx, by, bw, bh, label, dashed in frames:
        out.append(f'<rect x="{bx}" y="{by}" width="{bw}" height="{bh}" rx="22" fill="{"none" if dashed else "#ffffff"}" fill-opacity=".55" stroke="#94a3b8" stroke-width="1.6"{dash(dashed, "8 6")}/>')
        out.append(f'<text x="{bx + 24}" y="{by + 32}" class="bl" fill="#64748b">{esc(label.upper())}</text>')
    out += edges
    for n, (x, yy, w, h, dashed) in pos.items():
        svc = svcs[n]
        out.append(f'<rect x="{x}" y="{yy:.1f}" width="{w}" height="{h}" rx="14" fill="#fff" stroke="{"#cbd5e1" if dashed else "#1f2a37"}" stroke-width="{1.4 if dashed else 1.8}"/>')
        out.append(f'<text x="{x + 16}" y="{yy + 26:.1f}" class="cn">{esc(n)}</text>')
        if svc["health"]:
            out.append(f'<circle cx="{x + w - 18}" cy="{yy + 20:.1f}" r="5" fill="#16a34a"><title>health check</title></circle>')
        out.append(f'<text x="{x + 16}" y="{yy + 46:.1f}" class="ci">{esc(svc["image"])}</text>')
        ty = yy + 70
        if svc["ports"]:
            tx = x + 16
            for p in svc["ports"][:3]:
                tw = len(p) * 7.2 + 16
                out.append(f'<rect x="{tx}" y="{ty - 14:.1f}" width="{tw:.1f}" height="19" rx="9.5" fill="#dbeafe"/><text x="{tx + 8}" y="{ty:.1f}" class="tag" fill="#1d4ed8">{esc(p)}</text>')
                tx += tw + 6
            ty += 22
        if svc["volumes"]:
            tx = x + 16
            for v in svc["volumes"][:3]:
                col = vol_colors.get(v, "#475569")
                tw = len(v) * 7.2 + 16
                out.append(f'<rect x="{tx}" y="{ty - 14:.1f}" width="{tw:.1f}" height="19" rx="4" fill="{col}" fill-opacity=".14"/><text x="{tx + 8}" y="{ty:.1f}" class="tag" fill="{col}">{esc(v)}</text>')
                tx += tw + 6
    footer = "DRAWN FROM " + source + (f"  \u00b7  {date}" if date else "")
    out.append(f'<text x="{W / 2:.1f}" y="{H - 28}" text-anchor="middle" class="ft">{esc(footer.upper())}</text></svg>')
    return "\n".join(out) + "\n", W, H


# --- command line ------------------------------------------------------------

def main(argv=None):
    ap = argparse.ArgumentParser(prog="feature-map", description="Draw what a tool does as one picture.")
    ap.add_argument("--version", action="version", version=f"feature-map {VERSION}")
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("render", help="draw the map")
    r.add_argument("spec")
    r.add_argument("-o", "--output")
    r.add_argument("--format", choices=["svg", "html", "png", "mermaid"])
    c = sub.add_parser("check", help="validate the outline")
    c.add_argument("spec")
    d = sub.add_parser("draft", help="draft an outline from a tool's help text or Makefile")
    d.add_argument("kind", choices=["help", "make"])
    d.add_argument("source", help="a file, or - for standard input")
    d.add_argument("--title", required=True)
    d.add_argument("--source-name", help="what the map will say it was drawn from")
    f = sub.add_parser("drift", help="what a tool has that its map does not show, and the reverse")
    f.add_argument("spec")
    f.add_argument("kind", choices=["help", "make"])
    f.add_argument("source", help="a file, or - for standard input")
    k = sub.add_parser("stack", help="draw a Docker Compose stack from `docker compose config --format json`")
    k.add_argument("source", help="the JSON, a file or - for standard input")
    k.add_argument("-o", "--output")
    k.add_argument("--title")
    k.add_argument("--subtitle", default="The services, and how they connect")
    k.add_argument("--source-name", default="docker compose config")
    k.add_argument("--date", default="")
    args = ap.parse_args(argv)

    if args.cmd == "stack":
        try:
            text = sys.stdin.read() if args.source == "-" else Path(args.source).read_text(encoding="utf-8")
            model = read_compose(text)
        except (SpecError, json.JSONDecodeError) as exc:
            print(f"feature-map: {args.source}: {exc}", file=sys.stderr)
            return 1
        except OSError as exc:
            print(f"feature-map: {exc}", file=sys.stderr)
            return 2
        title = args.title or model["name"] or "Stack"
        body, w, h = stack_svg(model, title, args.subtitle, args.source_name, args.date)
        return write_output(body, w, h, title, args.output)

    if args.cmd == "draft":
        try:
            groups = read_source(args.kind, args.source)
        except OSError as exc:
            print(f"feature-map: {exc}", file=sys.stderr)
            return 2
        if not groups:
            print(f"feature-map: found no commands in that {args.kind} text", file=sys.stderr)
            return 1
        name = args.source_name or (f"its {args.kind} text" if args.source == "-" else f"{Path(args.source).name}")
        sys.stdout.write(draft(groups, args.title, name) + "\n")
        return 0

    try:
        spec = load(args.spec)
    except (SpecError, json.JSONDecodeError) as exc:
        print(f"feature-map: {args.spec}: {exc}", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"feature-map: {exc}", file=sys.stderr)
        return 2
    if args.cmd == "drift":
        try:
            groups = read_source(args.kind, args.source)
        except OSError as exc:
            print(f"feature-map: {exc}", file=sys.stderr)
            return 2
        missing, stale = drift(spec, groups)
        for n in missing:
            print(f"not on the map: {n}")
        for n in stale:
            print(f"on the map, not in the source: {n}")
        if missing or stale:
            print(f"feature-map: {spec['title']} has drifted: {len(missing)} not shown, {len(stale)} gone. "
                  "Add what is missing, or declare it with 'omit:'.", file=sys.stderr)
            return 1
        return 0
    if args.cmd == "check":
        items = sum(len(g["items"]) for g in spec["groups"])
        planned = sum(1 for g in spec["groups"] for i in g["items"] if g["planned"] or i.get("planned"))
        print(f"{spec['title']}: {len(spec['groups'])} groups, {items} items, {planned} not done yet; drawn from {spec['source']}")
        return 0
    fmt = args.format or (Path(args.output).suffix.lstrip(".") if args.output else "svg")
    if fmt not in ("svg", "html", "png", "mermaid", "mmd"):
        print(f"feature-map: cannot tell the format from {args.output!r}; pass --format", file=sys.stderr)
        return 2
    if fmt == "png":
        if not args.output:
            print("feature-map: png needs -o FILE", file=sys.stderr)
            return 2
        try:
            png(spec, args.output)
        except (RuntimeError, subprocess.TimeoutExpired) as exc:
            print(f"feature-map: {exc}", file=sys.stderr)
            return 3
        return 0
    text = {"svg": svg, "html": page, "mermaid": mermaid, "mmd": mermaid}[fmt](spec)
    if args.output:
        Path(args.output).write_text(text, encoding="utf-8")
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
