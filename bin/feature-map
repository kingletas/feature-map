#!/usr/bin/env python3
"""feature-map -- draw what a tool does as one picture, from a plain outline.

A tool that keeps growing is hard to hold in your head. Its README lists every
flag, and nobody reads a README to find out what the thing is for. A feature map
is the other view: every capability, grouped by the job it does, around the
tool's name, with the things it does not do yet drawn in dashes beside the rest.

The picture is only worth having while it is true, so the outline it is drawn
from says where its list came from, and that source is printed on the map. A
map with no source is refused, and so is one that names the same feature twice.

Usage:
    feature-map render SPEC [-o OUT] [--format svg|html|png|mermaid]
    feature-map check SPEC          validate the outline and print what it holds
    feature-map draft help|make SOURCE --title T    draft an outline from help text or a Makefile
    feature-map drift SPEC help|make SOURCE         what the tool has that the map does not show
    feature-map stack [LABEL=]COMPOSE_JSON... [-o OUT]   draw a Docker Compose stack (experimental)
    feature-map --version

SPEC is a Markdown outline (see docs/format.md) or the same thing as JSON.
Without -o, svg and mermaid go to stdout. The format follows OUT's extension
unless --format says otherwise. png needs a Chromium-based browser on PATH, or
its path in FEATURE_MAP_BROWSER.

SOURCE is a file, or - to read standard input: `mytool --help | feature-map
draft help - --title Mytool`. Nothing is ever run on your behalf.

Exit codes: 0 done (drift: nothing drifted), 1 the input is refused, the map
has drifted, or a draft found no commands, 2 bad usage, 3 png failed.
"""

import argparse
import datetime
import html
import json
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
import textwrap
from pathlib import Path

VERSION = "0.3.0"

PALETTE = ["#2563eb", "#16a34a", "#d97706", "#7c3aed", "#0d9488", "#db2777", "#4f46e5", "#ca8a04"]
PLANNED = "#b91c1c"

# Layout constants, in SVG pixels. The character widths are estimates for the
# fonts below; a wrong estimate makes a pill a little wide, never overlapping.
PILL_WRAP = 34
CHAR_W = 7.4
HEAD_CHAR_W = 8.6
LINE_H = 19
PILL_PAD = 18
PILL_GAP = 12
GROUP_GAP = 60
RX = 380
PILL_OFFSET = 190
TOP = 300


class SpecError(ValueError):
    """The outline cannot be drawn truthfully."""


# --- reading the outline -----------------------------------------------------

KEY_RE = re.compile(r"^([a-z][a-z-]*):\s*(.*)$")
SETTINGS = ("source", "date", "center", "center-sub", "omit", "planned-label")
TAG_RE = re.compile(r"\s*\[planned\]\s*$", re.IGNORECASE)
HEAD_RE = re.compile(r"^\*\*(.+?)\*\*(?::\s*(.*)|\s*$)")
HEX_RE = re.compile(r"#(?:[0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})")


def parse_markdown(text):
    """Turn the outline into a spec dict. Unknown lines are an error, not ignored."""
    spec = {"lede": [], "groups": []}
    group = None
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.rstrip()
        if not line.strip():
            continue
        if line.startswith("# "):
            spec["title"] = line[2:].strip()
        elif line.startswith("> "):
            spec["subtitle"] = line[2:].strip()
        elif line.startswith("## "):
            name = line[3:].strip()
            planned = bool(TAG_RE.search(name))
            group = {"name": TAG_RE.sub("", name), "planned": planned, "items": []}
            spec["groups"].append(group)
        elif line.lstrip().startswith("- "):
            if group is None:
                raise SpecError(f"line {n}: an item before any '## group'")
            body = line.lstrip()[2:].strip()
            planned = bool(TAG_RE.search(body))
            body = TAG_RE.sub("", body)
            item = {"text": body, "planned": planned}
            m = HEAD_RE.match(body)
            if m:
                item = {"head": m.group(1), "text": m.group(2) or "", "planned": planned}
            group["items"].append(item)
        elif group is None and KEY_RE.match(line):
            key, value = KEY_RE.match(line).groups()
            if key not in SETTINGS:
                raise SpecError(f"line {n}: {key + ':'!r} is not a setting; the settings are "
                                + ", ".join(k + ":" for k in SETTINGS))
            spec[key.replace("-", "_")] = value.strip()
        elif group is None:
            spec["lede"].append(line.strip())
        else:
            raise SpecError(f"line {n}: not an item, a group or a setting: {line.strip()!r}")
    return spec


def read_text(path):
    """A file, or standard input for '-'. A byte-order mark is dropped, since
    one in front of '# title' would hide the title."""
    return sys.stdin.read().lstrip("\ufeff") if path == "-" else Path(path).read_text(encoding="utf-8-sig")


def load(path):
    text = read_text(path)
    spec = json.loads(text) if str(path).endswith(".json") else parse_markdown(text)
    if not isinstance(spec, dict):
        raise SpecError("a JSON outline is an object with a title, a source and groups")
    return normalise(spec)


def normalise(spec):
    """Fill defaults and refuse a map that would not be true."""
    if not spec.get("title"):
        raise SpecError("the outline has no '# title'")
    if not spec.get("source"):
        raise SpecError("the outline has no 'source:' line; a map says where its list came from")
    groups = spec.get("groups") or []
    if not groups:
        raise SpecError("the outline has no '## group'")
    seen = {}
    for gi, g in enumerate(groups):
        if not isinstance(g, dict) or not g.get("name"):
            raise SpecError(f"group {gi + 1} has no name")
        g.setdefault("planned", False)
        if not g.get("items"):
            raise SpecError(f"group {g.get('name')!r} has no items")
        for it in g["items"]:
            if isinstance(it, str):
                it = {"text": it}
            # A feature is its bold name when it has one: the same name under
            # two groups is the same feature, however it is described.
            label = (it.get("head") or it.get("text", "")).strip().lower()
            if label in seen:
                raise SpecError(f"{label!r} appears twice, under {seen[label]!r} and {g['name']!r}")
            seen[label] = g["name"]
        g["items"] = [({"text": i} if isinstance(i, str) else i) for i in g["items"]]
        # A colour is written into SVG attributes as it stands, so anything but
        # a hex colour is refused rather than escaped: an outline from someone
        # else could otherwise close the attribute and add a script.
        if "color" in g and not HEX_RE.fullmatch(str(g["color"])):
            raise SpecError(f"group {g.get('name')!r}: color must be a hex colour such as #2563eb")
        g.setdefault("color", PLANNED if g["planned"] else PALETTE[gi % len(PALETTE)])
    spec.setdefault("subtitle", "")
    spec.setdefault("center", spec["title"])
    spec.setdefault("center_sub", "")
    spec.setdefault("date", "")
    spec.setdefault("planned_label", "not done yet")
    omit = spec.get("omit") or []
    spec["omit"] = [o.strip() for o in (omit.split(",") if isinstance(omit, str) else omit) if o.strip()]
    lede = spec.get("lede") or []
    spec["lede"] = textwrap.wrap(" ".join(lede), 52) if isinstance(lede, list) else textwrap.wrap(lede, 52)
    return spec


# --- layout ------------------------------------------------------------------

def wrap(text, width=PILL_WRAP):
    return textwrap.wrap(text, width) or [text or " "]


def pill_size(item):
    lines = wrap(item["text"]) if item.get("text") else []
    head = item.get("head")
    width = max([len(line) * CHAR_W for line in lines] + [len(head) * HEAD_CHAR_W if head else 0]) + 34
    height = (LINE_H if head else 0) + len(lines) * LINE_H + PILL_PAD
    return width, height


def layout(spec):
    """Place every group and pill. Returns geometry only; drawing is separate,
    so the tests can check that nothing overlaps without rendering anything."""
    groups = spec["groups"]
    planned = [g for g in groups if g["planned"]]
    shipped = [g for g in groups if not g["planned"]]
    bottom = planned[:1]
    sides = shipped + planned[1:]
    def stack_height(g):
        return sum(pill_size(i)[1] for i in g["items"]) + PILL_GAP * (len(g["items"]) - 1)

    def column_height(col):
        return sum(stack_height(g) for g in col) + GROUP_GAP * max(len(col) - 1, 0)

    # Split the groups, in order, where the two columns come out closest in
    # height, so a map with one crowded group does not lean to one side.
    half = min(range(len(sides) + 1),
               key=lambda k: (max(column_height(sides[:k]), column_height(sides[k:])), abs(2 * k - len(sides))))
    left, right = sides[:half], sides[half:]

    heights = [column_height(left), column_height(right)]
    rows = math.ceil(len(bottom[0]["items"]) / 3) if bottom else 0
    # The planned row under the centre is a grid of three; its pitch comes from
    # its own widest and tallest pills, so long planned items never touch.
    below = [pill_size(i) for i in bottom[0]["items"]] if bottom else []
    col_pitch = max([300] + [w + 24 for w, _ in below])
    row_pitch = max([78] + [h + 16 for _, h in below])
    body = max(heights + [360])
    height = int(TOP + body + (140 + rows * row_pitch + 60 if bottom else 60) + 80)
    widest = max([pill_size(i)[0] for g in groups for i in g["items"]] + [200])
    width = int(max(1800, 2 * (RX + PILL_OFFSET + widest + 60), 3 * col_pitch + 120))
    cx, cy = width / 2, TOP + body / 2

    placed, pills = [], []
    for side, col, total in ((-1, left, heights[0]), (1, right, heights[1])):
        y = cy - total / 2
        for g in col:
            st = stack_height(g)
            gx, gy = cx + side * RX, y + st / 2
            placed.append({"group": g, "x": gx, "y": gy, "side": side})
            yy = y
            px = cx + side * (RX + PILL_OFFSET)
            for it in g["items"]:
                w, h = pill_size(it)
                x = px if side > 0 else px - w
                pills.append({"item": it, "group": g, "x": x, "y": yy, "w": w, "h": h, "side": side, "gx": gx, "gy": gy})
                yy += h + PILL_GAP
            y += st + GROUP_GAP
    for g in bottom:
        gx, gy = cx, TOP + body + 70
        placed.append({"group": g, "x": gx, "y": gy, "side": 0})
        k = len(g["items"])
        for idx, it in enumerate(g["items"]):
            r, c = divmod(idx, 3)
            cnt = min(3, k - r * 3)
            w, h = pill_size(it)
            px = gx + (c - (cnt - 1) / 2) * col_pitch
            py = gy + 60 + row_pitch / 2 + r * row_pitch
            pills.append({"item": it, "group": g, "x": px - w / 2, "y": py - h / 2, "w": w, "h": h, "side": 0, "gx": gx, "gy": gy})
    return {"width": width, "height": height, "cx": cx, "cy": cy, "groups": placed, "pills": pills}


# --- drawing -----------------------------------------------------------------

FONTS = "https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Inter:wght@400;500;700&display=swap"

STYLE = """
.tt{font:600 58px 'Fraunces',Georgia,serif;fill:#1f2a37}
.st{font:400 26px 'Fraunces',Georgia,serif;fill:#1f2a37}
.lede{font:400 19px 'Inter',system-ui,sans-serif;fill:#4b5563}
.ph{font:700 15px 'Inter',system-ui,sans-serif}
.pt{font:500 14.5px 'Inter',system-ui,sans-serif;fill:#1f2937}
.gt{font:700 20px 'Inter',system-ui,sans-serif}
.ct{font:700 22px 'Fraunces',Georgia,serif;fill:#fff}
.cs{font:500 12px 'Inter',system-ui,sans-serif;fill:#cbd5e1}
.ft{font:500 13px 'Inter',system-ui,sans-serif;fill:#6b7280;letter-spacing:.14em}
.lg{font:500 14px 'Inter',system-ui,sans-serif;fill:#374151}
"""


def esc(text):
    return html.escape(str(text), quote=True)


def dash(on, pattern):
    return f' stroke-dasharray="{pattern}"' if on else ""


def svg(spec):
    geo = layout(spec)
    W, H, cx, cy = geo["width"], geo["height"], geo["cx"], geo["cy"]
    out = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}" role="img">',
           f"<title>{esc(spec['title'])} feature map</title>", f"<style>{STYLE}</style>",
           f'<rect width="{W}" height="{H}" fill="#f7f5ef"/>',
           f'<text x="60" y="92" class="tt">{esc(spec["title"])}</text>',
           f'<text x="62" y="130" class="st">{esc(spec["subtitle"])}</text>']
    out += [f'<text x="62" y="{172 + i * 26}" class="lede">{esc(line)}</text>' for i, line in enumerate(spec["lede"])]
    out.append(f'<g transform="translate({W - 330},60)">'
               '<rect width="16" height="16" rx="8" fill="#6b7280"/><text x="26" y="13" class="lg">shipped and in use</text>'
               f'<rect y="30" width="16" height="16" rx="8" fill="#fff" stroke="{PLANNED}" stroke-width="1.6" stroke-dasharray="4 3"/>'
               f'<text x="26" y="43" class="lg">{esc(spec["planned_label"])}</text></g>')
    for g in geo["groups"]:
        col, neg = g["group"]["color"], g["group"]["planned"]
        mx = (cx + g["x"]) / 2 + (g["y"] - cy) * 0.15
        my = (cy + g["y"]) / 2 - (g["x"] - cx) * 0.15
        out.append(f'<path d="M{cx:.1f},{cy:.1f} Q{mx:.1f},{my:.1f} {g["x"]:.1f},{g["y"]:.1f}" stroke="{col}" '
                   f'stroke-width="{4 if neg else 7}" fill="none" stroke-linecap="round" opacity=".85"{dash(neg, "10 8")}/>')
    for p in geo["pills"]:
        col = p["group"]["color"]
        neg = p["group"]["planned"] or p["item"].get("planned")
        side = p["side"]
        if side:
            ex, ey = p["gx"] + side * 95, p["gy"]
            px, py = (p["x"] if side > 0 else p["x"] + p["w"]), p["y"] + p["h"] / 2
            mid = (ex + px) / 2
            d = f"M{ex:.1f},{ey:.1f} C{mid:.1f},{ey:.1f} {mid:.1f},{py:.1f} {px:.1f},{py:.1f}"
        else:
            ex, ey = p["gx"], p["gy"] + 24
            px, py = p["x"] + p["w"] / 2, p["y"]
            d = f"M{ex:.1f},{ey:.1f} C{ex:.1f},{(ey + py) / 2:.1f} {px:.1f},{(ey + py) / 2:.1f} {px:.1f},{py:.1f}"
        out.append(f'<path d="{d}" stroke="{PLANNED if neg else col}" stroke-width="2.2" fill="none" opacity=".7"{dash(neg, "6 5")}/>')
    for p in geo["pills"]:
        col = PLANNED if (p["group"]["planned"] or p["item"].get("planned")) else p["group"]["color"]
        neg = col == PLANNED
        r = p["h"] / 2 if p["h"] < 50 else 18
        out.append(f'<rect x="{p["x"]:.1f}" y="{p["y"]:.1f}" width="{p["w"]:.1f}" height="{p["h"]:.1f}" rx="{r:.1f}" '
                   f'fill="#fff" stroke="{col}" stroke-width="1.6"{dash(neg, "5 4")}/>')
        out.append(f'<rect x="{p["x"]:.1f}" y="{p["y"]:.1f}" width="{p["w"]:.1f}" height="{p["h"]:.1f}" rx="{r:.1f}" fill="{col}" fill-opacity=".13"/>')
        ty, mx = p["y"] + 22, p["x"] + p["w"] / 2
        if p["item"].get("head"):
            out.append(f'<text x="{mx:.1f}" y="{ty:.1f}" text-anchor="middle" class="ph" fill="{col}">{esc(p["item"]["head"])}</text>')
            ty += LINE_H
        if p["item"].get("text"):
            for line in wrap(p["item"]["text"]):
                out.append(f'<text x="{mx:.1f}" y="{ty:.1f}" text-anchor="middle" class="pt">{esc(line)}</text>')
                ty += LINE_H
    for g in geo["groups"]:
        col, neg = g["group"]["color"], g["group"]["planned"]
        lines = wrap(g["group"]["name"], 16)
        w, h = max(len(line) for line in lines) * 10.5 + 48, len(lines) * 24 + 34
        out.append(f'<rect x="{g["x"] - w / 2:.1f}" y="{g["y"] - h / 2:.1f}" width="{w:.1f}" height="{h:.1f}" rx="{h / 2:.1f}" '
                   f'fill="{"#fff" if neg else col}" stroke="{col}" stroke-width="3"{dash(neg, "8 6")}/>')
        for i, line in enumerate(lines):
            out.append(f'<text x="{g["x"]:.1f}" y="{g["y"] - h / 2 + 30 + i * 24:.1f}" text-anchor="middle" class="gt" '
                       f'fill="{col if neg else "#fff"}">{esc(line)}</text>')
    r = 100
    hexagon = " ".join(f"{cx + r * math.cos(math.radians(60 * i - 30)):.1f},{cy + r * math.sin(math.radians(60 * i - 30)):.1f}" for i in range(6))
    out.append(f'<polygon points="{hexagon}" fill="#1f2a37"/>')
    out.append(f'<text x="{cx:.1f}" y="{cy - 2:.1f}" text-anchor="middle" class="ct">{esc(spec["center"])}</text>')
    for i, line in enumerate(s for s in spec["center_sub"].split(" · ") if s):
        out.append(f'<text x="{cx:.1f}" y="{cy + 24 + i * 16:.1f}" text-anchor="middle" class="cs">{esc(line)}</text>')
    footer = "DRAWN FROM " + spec["source"] + (f"  ·  {spec['date']}" if spec["date"] else "")
    out.append(f'<text x="{W / 2:.1f}" y="{H - 28}" text-anchor="middle" class="ft">{esc(footer.upper())}</text>')
    out.append("</svg>")
    return "\n".join(out) + "\n"


def html_page(title, body):
    return (f'<!doctype html><html><head><meta charset="utf-8"><title>{esc(title)}</title>'
            f'<link rel="stylesheet" href="{FONTS}"></head><body style="margin:0;background:#f7f5ef">{body}</body></html>\n')


def page(spec):
    return html_page(f"{spec['title']} feature map", svg(spec))


def mermaid(spec):
    """The same map as a Mermaid tree, for a Markdown page that renders it."""
    def q(text):
        return text.replace('"', "'").replace("[", "(").replace("]", ")")
    out = ["flowchart LR", f'  R(["{q(spec["title"])}"])']
    n = 0
    for gi, g in enumerate(spec["groups"], 1):
        out.append(f'  R --> G{gi}["{q(g["name"])}"]')
        out.append(f"  class G{gi} {'nogrp' if g['planned'] else 'grp'}")
        for it in g["items"]:
            n += 1
            label = (f"{it['head']}: " if it.get("head") else "") + it.get("text", "")
            out.append(f'  G{gi} --- N{n}["{q(label)}"]')
            if g["planned"] or it.get("planned"):
                out.append(f"  class N{n} no")
    out += ["  classDef grp font-weight:bold",
            f"  classDef nogrp font-weight:bold,fill:#fbe3e3,stroke:{PLANNED}",
            f"  classDef no fill:#fdf0f0,stroke:{PLANNED},stroke-dasharray:4 3"]
    return "\n".join(out) + "\n"


# --- png ---------------------------------------------------------------------

def write_output(body, width, height, title, output):
    """svg, html or png, by the output's extension; svg to stdout without one."""
    fmt = Path(output).suffix.lstrip(".") if output else "svg"
    if fmt not in ("svg", "html", "png"):
        print(f"feature-map: a stack is drawn as .svg, .html or .png, not {Path(output).suffix or 'no extension'}", file=sys.stderr)
        return 2
    wrapped = html_page(title, body)
    if fmt == "png":
        try:
            screenshot(wrapped, width, height, output)
        except (RuntimeError, subprocess.TimeoutExpired) as exc:
            print(f"feature-map: {exc}", file=sys.stderr)
            return 3
        return 0
    text = wrapped if fmt == "html" else body
    if output:
        Path(output).write_text(text, encoding="utf-8")
    else:
        sys.stdout.write(text)
    return 0


def browser():
    named = os.environ.get("FEATURE_MAP_BROWSER")
    if named:
        # Asked for by name, so a missing one is an error, not a quiet fallback.
        path = shutil.which(named)
        if not path:
            raise RuntimeError(f"FEATURE_MAP_BROWSER names {named!r}, which is not an executable on PATH")
        return path
    for name in ("chromium", "chromium-browser", "google-chrome", "google-chrome-stable"):
        path = shutil.which(name)
        if path:
            return path
    return None


def screenshot(html_page, width, height, out):
    exe = browser()
    if not exe:
        raise RuntimeError("png needs a Chromium-based browser on PATH, or FEATURE_MAP_BROWSER set")
    out = Path(out).resolve()
    # An old picture left from an earlier run must not pass for this one.
    out.unlink(missing_ok=True)
    # Written beside the output, not in /tmp: a sandboxed browser may not see /tmp.
    with tempfile.TemporaryDirectory(dir=out.parent, prefix=".feature-map-") as tmp:
        src = Path(tmp) / "map.html"
        src.write_text(html_page, encoding="utf-8")
        cmd = [exe, "--headless=new", "--disable-gpu", "--hide-scrollbars", "--virtual-time-budget=8000",
               f"--window-size={width},{height}", f"--screenshot={out}", src.as_uri()]
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=120, check=False)
    if result.returncode != 0 or not out.exists():
        raise RuntimeError(f"the browser did not write {out.name}: {result.stderr.strip()[-300:]}")


def png(spec, out):
    geo = layout(spec)
    screenshot(page(spec), geo["width"], geo["height"], out)


# --- reading a tool's own description: draft and drift ------------------------

# A help line names a command, then its description after two or more spaces:
#   "  up                     Start everything". A deeper-indented line with no
# gap is the previous description continuing onto the next line.
HELP_CMD_RE = re.compile(r"^(\s{1,8})(\S(?:.*?\S)?)\s{2,}(\S.*)$")
HELP_BARE_RE = re.compile(r"^(\s{1,8})([a-z][\w:|.-]*)((?:\s+[\[<A-Z-].*)?)$")
MAKE_RE = re.compile(r"^([A-Za-z0-9_.-]+):[^=]*?##\s*(.+)$")


def read_help(text):
    """Commands grouped under the help text's own headings, in order.

    Returns [(heading, [(name, description)])]. A heading is an unindented line
    that is not a usage line; commands before any heading go under 'Commands'."""
    groups, current, skipping = [], None, False
    for raw in text.splitlines():
        line = raw.rstrip()
        if not line.strip():
            continue
        if not line[0].isspace():
            # A usage, options, exit-code or environment section lists things
            # that are not commands, so everything under it is skipped.
            heading = line.lower()
            skipping = (heading.startswith(("usage", "flags", "exit", "environment", "example"))
                        or "option" in heading or "optional argument" in heading)
            current = None if skipping else (line.strip().rstrip(":"), [])
            if current:
                groups.append(current)
            continue
        if skipping:
            continue
        if line.lstrip().startswith("-"):
            continue
        m = HELP_CMD_RE.match(line)
        if not m:
            m2 = HELP_BARE_RE.match(line)
            if m2 and current is not None:
                current[1].append([command_name(m2.group(2) + m2.group(3)), ""])
            elif current is not None and current[1]:
                current[1][-1][1] = (current[1][-1][1] + " " + line.strip()).strip()
            continue
        if current is None:
            current = ("Commands", [])
            groups.append(current)
        current[1].append([command_name(m.group(2)), m.group(3).strip()])
    return [(h, [tuple(c) for c in cmds]) for h, cmds in groups if cmds]


def command_name(usage):
    """The command in a usage fragment: 'scale [web=N] [-y]' is 'scale'."""
    words = []
    for word in usage.split():
        if word[0] in "[<-" or word.isupper() or "=" in word:
            break
        words.append(word)
    return " ".join(words) or usage.split()[0]


def read_make(text):
    """Targets documented with a '## description' comment, the self-documenting
    Makefile convention, under one 'Make targets' group."""
    cmds = [(m.group(1), m.group(2).strip()) for m in map(MAKE_RE.match, text.splitlines()) if m]
    return [("Make targets", cmds)] if cmds else []


def read_source(kind, path):
    text = read_text(path)
    return read_help(text) if kind == "help" else read_make(text)


def draft(groups, title, source):
    """An outline to curate, never to publish as it is: every command becomes an
    item, and the person drawing the map regroups, trims and declares omissions."""
    out = [f"# {title}", "> TODO: one line on what it is for", "",
           f"source: {source}", f"date: {datetime.datetime.now().astimezone().date().isoformat()}", ""]
    for heading, cmds in groups:
        out.append(f"## {heading}")
        for name, desc in cmds:
            first = re.split(r"(?<=[.;,])\s", desc, maxsplit=1)[0].rstrip(".;,")
            out.append(f"- **{name}**: {first[:1].lower() + first[1:]}" if first else f"- **{name}**")
        out.append("")
    return "\n".join(out)


def names_on_map(spec):
    """Every command a map's bold names cover. 'up and down' covers up and down;
    'ps, logs and info' covers all three; 'node|npm' covers both."""
    covered = set()
    for g in spec["groups"]:
        for it in g["items"]:
            if it.get("head"):
                for part in re.split(r",\s*|\s+and\s+", it["head"]):
                    covered.update(alternatives(part.strip().lower()))
    return covered


def alternatives(name):
    """'scale refresh|reseed' is two commands, 'scale refresh' and 'scale
    reseed'; 'node|npm' is 'node' and 'npm'. A '<placeholder>' is not a name."""
    if name.startswith("<"):
        return []
    words = name.split()
    last = words[-1].split("|") if words else []
    return [" ".join(words[:-1] + [w]).strip() for w in last if w]


def drift(spec, groups):
    """What the source has that the map neither shows nor declares, and what the
    map names that the source no longer has. Planned items are exempt from the
    second list, since a planned feature is not in the source yet by definition."""
    source = {}
    for _, cmds in groups:
        for name, _ in cmds:
            for alt in alternatives(name.lower()):
                source[alt] = name
    shown = names_on_map(spec)
    omitted = {o.strip().lower() for o in spec.get("omit", [])}
    missing = sorted(n for n in source if n not in shown and n not in omitted and source[n].lower() not in omitted)
    planned = {a for g in spec["groups"] for it in g["items"] if it.get("head") and (g["planned"] or it.get("planned"))
               for p in re.split(r",\s*|\s+and\s+", it["head"]) for a in alternatives(p.strip().lower())}

    def still_there(n):
        # A name on the map may be a whole command or its first or last words:
        # 'scale' covers 'scale up'. It never matches inside a word, so a
        # removed 'up' is not hidden by 'update'.
        return any(k == n or k.startswith(n + " ") or k.endswith(" " + n) for k in source)
    stale = sorted(n for n in shown if n not in planned and not still_there(n))
    return missing, stale


# --- stack: a Compose file drawn as boxes and paths -------------------------

VAR_RE = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)(?:(:?-)([^}]*)|:?[?+][^}]*)?\}")


def plain(text):
    """'${HTTP_PORT:-8080}' reads as its default, '8080'. A variable with no
    default, or one that carries only an error message, stays a variable name,
    since the real value is not ours to show."""
    return VAR_RE.sub(lambda m: m.group(3) if m.group(2) else "$" + m.group(1), str(text))


def join_keys(name):
    """What a network name can be matched on across two Compose projects: the
    variable it is set from, and that variable's default. Two files that name a
    network from the same variable mean the same network, whatever fallback
    each one gives."""
    m = VAR_RE.fullmatch(str(name))
    if not m:
        return {str(name)}
    return {"$" + m.group(1)} | ({m.group(3)} if m.group(2) and m.group(3) else set())


def port_label(p):
    if isinstance(p, dict):
        pub, target = p.get("published"), p.get("target")
        return f"{plain(pub)} → {target}" if pub else str(target)
    parts = plain(p).rsplit(":", 2)
    return f"{parts[-2]} → {parts[-1]}" if len(parts) >= 2 else parts[-1]


def image_label(svc):
    if svc.get("build") and not svc.get("image"):
        return "built here"
    img = plain(svc.get("image", "built here"))
    name = img.split("/")[-1]
    return name if len(name) <= 30 else name[:29] + "…"


def read_compose(text, label=None):
    """Docker Compose's resolved form, as `docker compose config --format json`
    prints it. JSON only: no YAML parser is needed, and the tool runs nothing.

    A dependency that waits for another service to finish is kept apart from
    the rest as `after`: it is start order, not a path a request takes."""
    c = json.loads(text)
    if not isinstance(c, dict):
        raise SpecError("that is not a Compose configuration: expected an object with services")
    services = c.get("services") or {}
    if not services:
        raise SpecError("no services in that Compose configuration")
    project = c.get("name", "")
    nets = {}
    for key, v in (c.get("networks") or {}).items():
        v = v or {}
        name = str(v.get("name") or "")
        # Compose names an unnamed network <project>_<key>. That name says
        # nothing a reader needs, and no other project can mean it.
        generated = not name or name == f"{project}_{key}"
        nets[key] = {"external": bool(v.get("external")),
                     "label": key if generated else plain(name),
                     "joins": set() if generated else join_keys(name)}
    out = {}
    modes = {}
    for name, svc in services.items():
        svc_nets = svc.get("networks")
        svc_nets = (list(svc_nets.keys()) if isinstance(svc_nets, dict) else svc_nets) or ["default"]
        # network_mode replaces networks: the host's own, none at all, or
        # another service's. Compose prints no networks key for these.
        mode = str(svc.get("network_mode") or "")
        if mode.startswith(("service:", "container:")):
            modes[name] = mode.split(":", 1)[1]
        elif mode in ("host", "none"):
            # Not a network Compose owns, so it never becomes a box: the card
            # says it, and the service stays in the box its profile gives it.
            svc_nets = []
        vols = []
        for v in svc.get("volumes") or []:
            if isinstance(v, dict) and v.get("type") == "volume" and v.get("source"):
                vols.append(v["source"])
        deps = svc.get("depends_on") or {}
        if not isinstance(deps, dict):
            deps = {d: {} for d in deps}
        after = [d for d, v in deps.items() if (v or {}).get("condition") == "service_completed_successfully"]
        out[name] = {
            "image": image_label(svc),
            "networks": svc_nets,
            "ports": [port_label(p) for p in svc.get("ports") or []],
            "volumes": vols,
            "depends": [d for d in deps if d not in after],
            "after": after,
            "health": "healthcheck" in svc and not (svc["healthcheck"] or {}).get("disable"),
            "profiles": svc.get("profiles") or [],
            "members": [name],
            "mode": {"host": "host network", "none": "no network"}.get(mode, ""),
        }
    for name, other in modes.items():
        # Sharing another container's network puts a service wherever that one is.
        if other in out:
            out[name]["networks"] = list(out[other]["networks"])
            out[name]["mode"] = out[other]["mode"]
    return {"name": label or project, "services": out, "networks": nets}


def collapse(svcs):
    """Three or more services that differ only in their names are drawn once.

    Six queue consumers built from one image, on the same networks, with the
    same volumes and dependencies, are one idea to a reader, and six cards of
    them push the path off the page. Nothing may depend on them and none may
    publish a port, so no arrow ever has to choose one of them; they must also
    share the first word of their names, which becomes the card's name."""
    inbound = {d for s in svcs.values() for d in s["depends"] + s["after"]}
    groups = {}
    for n, s in svcs.items():
        if n in inbound or s["ports"] or "-" not in n:
            continue
        key = (n.split("-")[0], s["image"], tuple(s["networks"]), tuple(s["volumes"]), tuple(s["depends"]),
               tuple(s["after"]), s["health"], tuple(s["profiles"]))
        groups.setdefault(key, []).append(n)
    def folded(names):
        common = []
        for part in zip(*(m.split("-") for m in names)):
            if len(set(part)) > 1:
                break
            common.append(part[0])
        return "-".join(common) + "-*"
    candidates = [names for names in groups.values() if len(names) >= 3]
    counts = {}
    for names in candidates:
        counts[folded(names)] = counts.get(folded(names), 0) + 1
    # Two groups that would fold to one name are both drawn in full, so no
    # service ever disappears behind another group's card.
    first = {names[0]: names for names in candidates if counts[folded(names)] == 1 and folded(names) not in svcs}
    dropped = {n for names in first.values() for n in names}
    out = {}
    for n, s in svcs.items():
        if n in first:
            out[folded(first[n])] = dict(s, members=list(first[n]))
        elif n not in dropped:
            out[n] = s
    return out


def home_network(svc, nets):
    """The box a service is drawn in: the first network its own project owns.
    An external network it joins belongs to someone else, even when its name
    sorts first."""
    if not svc["networks"]:
        return None
    owned = [k for k in svc["networks"] if not nets.get(k, {}).get("external")]
    return owned[0] if owned else svc["networks"][0]


def stack_columns(names, svcs):
    """Left to right along the request path, returned with the data column.

    The entry is what the outside reaches, by a published port or over a
    network another stack owns, and depends on something; the services it
    reaches follow its paths. The last column holds the data stores: what is
    depended on, depends on nothing, and is used by a service that needs several
    ends of the line at once. A service off the path sits with a service it shares a
    volume with, since a shared socket or code volume puts two containers in
    the same tier."""
    depended = {d for n in names for d in svcs[n]["depends"] if d in names}
    entries = [n for n in names if (svcs[n]["ports"] or svcs[n].get("outside")) and svcs[n]["depends"] and n not in depended]
    depth = {n: 0 for n in entries}
    frontier = list(entries)
    while frontier:
        nxt = []
        for n in frontier:
            for d in svcs[n]["depends"]:
                if d in names and depth.get(d, -1) < depth[n] + 1:
                    depth[d] = depth[n] + 1
                    nxt.append(d)
        frontier = nxt
    # A data store is an end of the line (depended on, depending on nothing)
    # used by a service that needs two or more ends of the line at once, as an
    # application needs its database and its search. A proxy in front of a
    # cache and a debug web server needs two things, but only one of them ends
    # a line, so that server stays on the path as a next hop.
    leaves = {n for n in names if n in depended and not [d for d in svcs[n]["depends"] if d in names]}
    sinks = [n for n in names if n in leaves
             and any(n in svcs[m]["depends"] and len([d for d in svcs[m]["depends"] if d in leaves]) >= 2 for m in names)]
    for n in sinks:
        depth.pop(n, None)
    # A service off the path joins a volume mate's column. Up to five with no
    # mate at all stand in a row after the path; more go into columns of five,
    # so a stack with no depends_on is a block rather than a long strip.
    base = max(depth.values(), default=-1) + 1
    lonely = [n for n in names if n not in depth and n not in sinks
              and not [m for m in depth if set(svcs[m]["volumes"]) & set(svcs[n]["volumes"])]]
    per = 1 if len(lonely) <= 5 else 5
    for n in names:
        if n in depth or n in sinks:
            continue
        if n in lonely:
            depth[n] = base + lonely.index(n) // per
        else:
            mates = [m for m in depth if set(svcs[m]["volumes"]) & set(svcs[n]["volumes"])]
            depth[n] = max(depth[m] for m in mates)
    cols = {}
    for n in names:
        if n not in sinks:
            cols.setdefault(depth[n], []).append(n)
    ordered = [cols[k] for k in sorted(cols)]
    # Each column follows the order of what points into it, so web -> php-fpm
    # and web-admin -> php-admin run level instead of crossing. What nothing
    # points to keeps its place, after the rest.
    for ci in range(1, len(ordered)):
        row = {m: i for i, m in enumerate(ordered[ci - 1])}
        def key(n, at=ordered[ci].index, row=row):
            preds = [row[m] for m in row if n in svcs[m]["depends"]]
            return (0, sum(preds) / len(preds), at(n)) if preds else (1, 0, at(n))
        ordered[ci] = sorted(ordered[ci], key=key)
    return ordered, sinks


CARD_W, CARD_GAP, COL_GAP = 250, 18, 110
NAME_CHAR_W, SMALL_CHAR_W, TAG_CHAR_W = 8.9, 6.9, 7.2


def pills_width(labels):
    return sum(len(v) * TAG_CHAR_W + 22 for v in labels[:3]) - 6 if labels else 0


def after_line(svc):
    return "after " + ", ".join(svc["after"]) if svc["after"] else ""


def count_badge(svc):
    return f"×{len(svc['members'])}" if len(svc["members"]) > 1 else ""


def card_width(n, svc):
    """Wide enough for the longest line on the card. Widths are estimated from
    character counts, so this errs wide."""
    head = len(n) * NAME_CHAR_W + (26 if svc["health"] else 0) + (len(count_badge(svc)) * TAG_CHAR_W + 26 if count_badge(svc) else 0)
    lines = [head, len(svc["image"]) * SMALL_CHAR_W, len(after_line(svc)) * SMALL_CHAR_W,
             pills_width(svc["ports"]), pills_width(svc["volumes"]), pills_width(svc.get("outside", []))]
    return max(CARD_W, int(32 + max(lines) + 0.5))


def card_height(svc):
    return (58 + (22 if svc["ports"] else 0) + (22 if svc["volumes"] else 0)
            + (22 if svc.get("outside") else 0) + (18 if svc["after"] else 0))


def stack_svg(projects, title, subtitle, source, date):
    """One project, or several that run side by side. Services in different
    projects never depend on each other; what connects them is a network one
    declares and another joins as external, drawn as one line between boxes."""
    if isinstance(projects, dict):
        projects = [projects]
    multi = len(projects) > 1
    folded = [collapse(p["services"]) for p in projects]
    seen = {}
    for f in folded:
        for n in f:
            seen[n] = seen.get(n, 0) + 1
    svcs = {}
    for pi, (p, f) in enumerate(zip(projects, folded)):
        # Two projects may both have a db; Compose keeps them apart by project,
        # and so does the drawing, by naming each after its project.
        rename = {n: f"{p['name']}/{n}" for n in f if seen[n] > 1}
        for n, s in f.items():
            svcs[rename.get(n, n)] = dict(s, project=pi, depends=[rename.get(d, d) for d in s["depends"]],
                                          after=[rename.get(d, d) for d in s["after"]])

    # An external network one project joins and another declares, matched on
    # the variable or the name that sets it.
    joins = []
    for pi, p in enumerate(projects):
        for k, net in p["networks"].items():
            if not net["external"]:
                continue
            for qi, q in enumerate(projects):
                hit = next((k2 for k2, n2 in q["networks"].items()
                            if qi != pi and not n2["external"] and n2["joins"] & net["joins"]), None)
                if hit:
                    joins.append((pi, k, qi, hit))
                    break
    joined = {(pi, k) for pi, k, _, _ in joins}
    for s in svcs.values():
        nets = projects[s["project"]]["networks"]
        s["outside"] = ([s["mode"]] if s["mode"] else []) + [nets[k]["label"] for k in s["networks"]
                        if nets.get(k, {}).get("external") and (s["project"], k) not in joined]

    boxes, lede = [], ""
    for pi, p in enumerate(projects):
        mine = [n for n, s in svcs.items() if s["project"] == pi]
        nets = p["networks"]
        # A service others wait on to finish runs once and exits; it is start
        # order, so it sits apart from the path instead of on it.
        oneshot = {d for n in mine for d in svcs[n]["after"]} - {d for n in mine for d in svcs[n]["depends"]}
        rest = [n for n in mine if n not in oneshot]
        home = {n: home_network(svcs[n], nets) for n in rest}
        homes = [h for h in dict.fromkeys(home.values()) if h is not None]
        pre = f"{p['name']} · " if multi else ""
        these = []
        if len(homes) > 1:
            for h in homes:
                net = nets.get(h, {})
                these.append({"label": pre + "network: " + net.get("label", h), "names": [n for n in rest if home[n] == h],
                              "dashed": net.get("external", False), "path": True, "net": h})
            for mode in sorted({svcs[n]["mode"] for n in rest if home[n] is None}):
                these.append({"label": pre + mode, "names": [n for n in rest if home[n] is None and svcs[n]["mode"] == mode],
                              "dashed": False, "path": True, "net": None})
        else:
            h = homes[0] if homes else None
            these.append({"label": pre + "always running", "names": [n for n in rest if not svcs[n]["profiles"]],
                          "dashed": False, "path": True, "net": h})
            for prof in sorted({pr for n in rest for pr in svcs[n]["profiles"]}):
                these.append({"label": pre + f"opt-in profile: {prof}", "dashed": True, "path": False, "net": h,
                              "names": [n for n in rest if svcs[n]["profiles"] and svcs[n]["profiles"][0] == prof]})
            if not multi:
                where = f"one network ({nets.get(h, {}).get('label', h)})" if h else "the host's network"
                if h or all(svcs[n]["mode"] == "host network" for n in rest):
                    lede = f"Everything here lives on {where}, so the boxes say when a service runs."
        these.append({"label": pre + "runs once, before the rest", "names": [n for n in mine if n in oneshot],
                      "dashed": False, "path": False, "net": None})
        these = [b for b in these if b["names"]]
        if these:
            these[0]["path"] = True
        for b in these:
            b["project"] = pi
        boxes += these

    def box_for(pi, net=None):
        """The box holding a project's services on a network, or its first box."""
        mine = [b for b in boxes if b["project"] == pi]
        return next((b for b in mine if net and b["net"] == net), mine[0])

    links = []
    for pi, k, qi, k2 in joins:
        users = [n for n, s in svcs.items() if s["project"] == pi and k in s["networks"]]
        if not users:
            continue
        shown = [n + (f" ({count_badge(svcs[n])})" if count_badge(svcs[n]) else "") for n in users]
        listed = ", ".join(shown[:-1]) + " and " + shown[-1] if len(shown) > 1 else shown[0]
        dst = box_for(qi, k2)
        dst.setdefault("notes", []).append(f"Reached from {projects[pi]['name']} over its {k} network, by {listed}.")
        links.append((box_for(pi), dst))

    pos, frame_of, buses = {}, {}, []
    y = TOP - 40
    main_w = 0
    row_x, row_h = 60, 0
    for b in boxes:
        names = b["names"]
        if b["path"]:
            cols, sinks = stack_columns(names, svcs)
            if sinks:
                cols = cols + [sinks]
        else:
            per = min(4, len(names))
            cols, sinks = [names[i::per] for i in range(per)], []
        widths = [max(card_width(n, svcs[n]) for n in col) for col in cols]
        heights = [sum(card_height(svcs[n]) + CARD_GAP for n in col) - CARD_GAP for col in cols]
        notes = b.get("notes", [])
        head = 60 + 22 * len(notes) + (4 if notes else 0)
        bw = sum(widths) + (len(cols) - 1) * COL_GAP + 80
        for note in notes:
            bw = max(bw, int(len(note) * SMALL_CHAR_W + 60))
        bh = max(heights) + head + 30
        if b["path"]:
            if row_h:
                # Close the row of opt-in boxes above before the next path.
                y += row_h + 50
                row_x, row_h = 60, 0
            bx, by = 60, y
            y += bh + 50
        else:
            # Opt-in boxes flow in a row under their path, wrapping when full.
            if row_x + bw > max(main_w, 1500) + 60 and row_x > 60:
                row_x, y = 60, y + row_h + 40
                row_h = 0
            bx, by = row_x, y
            row_x += bw + 40
            row_h = max(row_h, bh)
        main_w = max(main_w, bx - 60 + bw)
        b["frame"] = (bx, by, bw, bh)
        x = bx + 40
        for ci, col in enumerate(cols):
            # The main path is centred so it reads as one line; opt-in boxes
            # are top-aligned, since they are lists rather than a path.
            cy = by + head + ((max(heights) - heights[ci]) / 2 if b["path"] else 0)
            for n in col:
                h = card_height(svcs[n])
                pos[n] = (x, cy, widths[ci], h, b["dashed"])
                frame_of[n] = b
                cy += h + CARD_GAP
            x += widths[ci] + COL_GAP
        if sinks:
            first = pos[sinks[0]]
            last = pos[sinks[-1]]
            buses.append((list(sinks), first[0] - 34, first[1], last[1] + last[3]))
    y += row_h + (50 if row_h else 0)
    W = int(max(1800, main_w + 120))
    H = int(y + 80)

    def anchor(n, side):
        x, yy, w, h, _ = pos[n]
        return (x + w, yy + h / 2) if side == "r" else (x, yy + h / 2)

    def curve(x1, y1, x2, y2):
        mid = (x1 + x2) / 2
        return (f'<path d="M{x1:.1f},{y1:.1f} C{mid:.1f},{y1:.1f} {mid:.1f},{y2:.1f} {x2 - 6:.1f},{y2:.1f}" '
                'stroke="#475569" stroke-width="1.8" fill="none" opacity=".75" marker-end="url(#arr)"/>')

    def route(points, style='stroke="#475569" stroke-width="1.8"'):
        d = "M" + " L".join(f"{x:.1f},{y:.1f}" for x, y in points)
        return f'<path d="{d}" {style} fill="none" opacity=".75" stroke-linejoin="round" marker-end="url(#arr)"/>'

    def climb(n, target, x2, y2, up_into=False):
        """An edge from a box below its target's never passes behind a card:
        it rises to the gap under the target's box, runs along it, climbs the
        gutter beside the target's column, and turns into the target."""
        x, yy, w, _, _ = pos[n]
        _, fy, _, fh = frame_of[target]["frame"]
        lane = fy + fh + 22
        # Leave from the right of the card, clear of its box's label above it.
        x1 = x + w - 40
        if up_into:
            return route([(x1, yy), (x1, lane), (x2, lane), (x2, y2 + 6)])
        gutter = x2 - COL_GAP / 2
        return route([(x1, yy), (x1, lane), (gutter, lane), (gutter, y2), (x2 - 6, y2)])

    def below(n, d):
        return pos[n][1] > pos[d][1] + pos[d][3] + 40

    edges = []
    for src, dst in links:
        # One line per joined network, down the left margin, so it never
        # crosses a card.
        sx, sy, _, sh = src["frame"]
        dx, dy, _, _ = dst["frame"]
        y1, y2 = sy + sh - 36, dy + 46
        edges.append(route([(sx, y1), (32, y1), (32, y2), (dx - 6, y2)],
                           'stroke="#475569" stroke-width="2.4" stroke-dasharray="8 5"'))
    for members, bus_x, top, bottom in buses:
        edges.append(f'<path d="M{bus_x:.1f},{top + 10:.1f} L{bus_x:.1f},{bottom - 10:.1f}" stroke="#475569" stroke-width="3" stroke-linecap="round" opacity=".55"/>')
        for m in members:
            _, yy, _, h, _ = pos[m]
            edges.append(f'<path d="M{bus_x:.1f},{yy + h / 2:.1f} L{pos[m][0] - 6:.1f},{yy + h / 2:.1f}" stroke="#475569" stroke-width="1.8" opacity=".75" marker-end="url(#arr)"/>')
    for n, svc in svcs.items():
        if n not in pos:
            continue
        deps = [d for d in svc["depends"] if d in pos]
        for members, bus_x, top, bottom in buses:
            hit = [d for d in deps if d in members]
            # Three or more arrows into the data column become one arrow into its bus.
            if len(hit) >= 3:
                x1, y1 = anchor(n, "r")
                target_y = min(max(y1, top + 20), bottom - 20)
                edges.append(climb(n, hit[0], bus_x, bottom - 4, up_into=True) if pos[n][1] > bottom + 40 else curve(x1, y1, bus_x + 6, target_y))
                deps = [d for d in deps if d not in members]
        for d in deps:
            if below(n, d):
                x2, y2 = anchor(d, "l")
                edges.append(climb(n, d, x2, y2))
                continue
            (x1, y1), (x2, y2) = anchor(n, "r"), anchor(d, "l")
            if x2 < x1:
                (x1, y1), (x2, y2) = anchor(n, "l"), anchor(d, "r")
            edges.append(curve(x1, y1, x2, y2))
    shared = {}
    for n, svc in svcs.items():
        for v in svc["volumes"]:
            shared.setdefault(v, []).append(n)
    vol_colors = {v: PALETTE[i % len(PALETTE)] for i, v in enumerate(sorted(v for v, u in shared.items() if len(u) > 1))}

    out = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}" role="img">',
           f"<title>{esc(title)} stack</title>", f"<style>{STYLE}.cn{{font:700 16px 'Inter',system-ui,sans-serif;fill:#1f2937}}.ci{{font:500 12.5px 'Inter',system-ui,sans-serif;fill:#6b7280}}.tag{{font:600 12px 'Inter',system-ui,sans-serif}}.bl{{font:700 13px 'Inter',system-ui,sans-serif;letter-spacing:.08em}}.bn{{font:500 13px 'Inter',system-ui,sans-serif;fill:#475569}}</style>",
           '<defs><marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#475569"/></marker></defs>',
           f'<rect width="{W}" height="{H}" fill="#f7f5ef"/>',
           f'<text x="60" y="92" class="tt">{esc(title)}</text>',
           f'<text x="62" y="130" class="st">{esc(subtitle)}</text>']

    # The legend names only what this drawing uses.
    keys = []
    if any(d in pos for s in svcs.values() for d in s["depends"]):
        keys.append('<path d="M0,{c} L34,{c}" stroke="#475569" stroke-width="1.8" marker-end="url(#arr)"/>|depends on')
    if vol_colors:
        keys.append('<rect x="0" y="{t}" width="34" height="16" rx="4" fill="#7c3aed" fill-opacity=".16"/>|same colour: a volume shared between services')
    dashed_box = '<rect x="0" y="{t}" width="34" height="18" rx="6" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="6 4"/>|'
    if any(b["dashed"] and b["label"].split("· ")[-1].startswith("opt-in") for b in boxes):
        keys.append(dashed_box + "runs only when its profile is asked for")
    if any(b["dashed"] and not b["label"].split("· ")[-1].startswith("opt-in") for b in boxes):
        keys.append(dashed_box + "external network")
    if links:
        keys.append('<path d="M0,{c} L34,{c}" stroke="#475569" stroke-width="2.4" stroke-dasharray="8 5"/>|a network one project declares and another joins')
    if any(s["outside"] for s in svcs.values()):
        keys.append('<rect x="0" y="{t}" width="34" height="18" rx="9" fill="none" stroke="#64748b" stroke-width="1.3" stroke-dasharray="4 3"/>|on a network this drawing does not show')
    if any(len(s["members"]) > 1 for s in svcs.values()):
        keys.append('<text x="17" y="{b}" text-anchor="middle" class="tag" fill="#334155">×N</text>|N services alike but for their names, drawn once')
    if any(s["health"] for s in svcs.values()):
        keys.append('<circle cx="17" cy="{c}" r="5" fill="#16a34a"/>|has a health check')
    legend = []
    for i, k in enumerate(keys):
        mark, text = k.split("|", 1)
        top = i * 28
        legend.append(mark.format(t=top, c=top + 8, b=top + 13) + f'<text x="46" y="{top + 13}" class="lg">{esc(text)}</text>')
    out.append(f'<g transform="translate({W - 440},48)">' + "".join(legend) + "</g>")
    if lede:
        out.append(f'<text x="62" y="172" class="lede">{esc(lede)}</text>')
    for b in boxes:
        bx, by, bw, bh = b["frame"]
        out.append(f'<rect x="{bx}" y="{by}" width="{bw}" height="{bh}" rx="22" fill="{"none" if b["dashed"] else "#ffffff"}" fill-opacity=".55" stroke="#94a3b8" stroke-width="1.6"{dash(b["dashed"], "8 6")}/>')
        out.append(f'<text x="{bx + 24}" y="{by + 32}" class="bl" fill="#64748b">{esc(b["label"].upper())}</text>')
        for i, note in enumerate(b.get("notes", [])):
            out.append(f'<text x="{bx + 24}" y="{by + 56 + 22 * i}" class="bn">{esc(note)}</text>')
    out += edges
    for n, (x, yy, w, h, dashed) in pos.items():
        svc = svcs[n]
        # A profiled service inside a box that is not about profiles is dashed itself.
        own_dash = bool(svc["profiles"]) and not dashed
        members = f"<title>{esc(', '.join(svc['members']))}</title>" if len(svc["members"]) > 1 else ""
        out.append(f'<rect x="{x}" y="{yy:.1f}" width="{w}" height="{h}" rx="14" fill="#fff" stroke="{"#cbd5e1" if dashed else "#1f2a37"}" stroke-width="{1.4 if dashed else 1.8}"{dash(own_dash, "6 4")}>{members}</rect>')
        out.append(f'<text x="{x + 16}" y="{yy + 26:.1f}" class="cn">{esc(n)}</text>')
        if count_badge(svc):
            bxx = x + 16 + len(n) * NAME_CHAR_W + 8
            bw_ = len(count_badge(svc)) * TAG_CHAR_W + 16
            out.append(f'<rect x="{bxx:.1f}" y="{yy + 12:.1f}" width="{bw_:.1f}" height="19" rx="9.5" fill="#e2e8f0"/><text x="{bxx + 8:.1f}" y="{yy + 26:.1f}" class="tag" fill="#334155">{esc(count_badge(svc))}</text>')
        if svc["health"]:
            out.append(f'<circle cx="{x + w - 18}" cy="{yy + 20:.1f}" r="5" fill="#16a34a"><title>health check</title></circle>')
        out.append(f'<text x="{x + 16}" y="{yy + 46:.1f}" class="ci">{esc(svc["image"])}</text>')
        ty = yy + 70
        if svc["after"]:
            out.append(f'<text x="{x + 16}" y="{yy + 64:.1f}" class="ci">{esc(after_line(svc))}</text>')
            ty += 18
        if svc["ports"]:
            tx = x + 16
            for p in svc["ports"][:3]:
                tw = len(p) * TAG_CHAR_W + 16
                out.append(f'<rect x="{tx}" y="{ty - 14:.1f}" width="{tw:.1f}" height="19" rx="9.5" fill="#dbeafe"/><text x="{tx + 8}" y="{ty:.1f}" class="tag" fill="#1d4ed8">{esc(p)}</text>')
                tx += tw + 6
            ty += 22
        if svc["volumes"]:
            tx = x + 16
            for v in svc["volumes"][:3]:
                col = vol_colors.get(v, "#475569")
                tw = len(v) * TAG_CHAR_W + 16
                out.append(f'<rect x="{tx}" y="{ty - 14:.1f}" width="{tw:.1f}" height="19" rx="4" fill="{col}" fill-opacity=".14"/><text x="{tx + 8}" y="{ty:.1f}" class="tag" fill="{col}">{esc(v)}</text>')
                tx += tw + 6
            ty += 22
        if svc["outside"]:
            tx = x + 16
            for v in svc["outside"][:3]:
                tw = len(v) * TAG_CHAR_W + 16
                out.append(f'<rect x="{tx}" y="{ty - 14:.1f}" width="{tw:.1f}" height="19" rx="9.5" fill="none" stroke="#64748b" stroke-width="1.2" stroke-dasharray="4 3"/><text x="{tx + 8}" y="{ty:.1f}" class="tag" fill="#475569">{esc(v)}</text>')
                tx += tw + 6
    footer = "DRAWN FROM " + source + (f"  ·  {date}" if date else "")
    out.append(f'<text x="{W / 2:.1f}" y="{H - 28}" text-anchor="middle" class="ft">{esc(footer.upper())}</text></svg>')
    return "\n".join(out) + "\n", W, H


# --- command line ------------------------------------------------------------

# Input that is read but cannot be drawn: exit 1, like any refused outline.
REFUSED = (SpecError, json.JSONDecodeError, UnicodeDecodeError)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="feature-map", description="Draw what a tool does as one picture.")
    ap.add_argument("--version", action="version", version=f"feature-map {VERSION}")
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("render", help="draw the map")
    r.add_argument("spec")
    r.add_argument("-o", "--output")
    r.add_argument("--format", choices=["svg", "html", "png", "mermaid"])
    c = sub.add_parser("check", help="validate the outline")
    c.add_argument("spec")
    d = sub.add_parser("draft", help="draft an outline from a tool's help text or Makefile")
    d.add_argument("kind", choices=["help", "make"])
    d.add_argument("source", help="a file, or - for standard input")
    d.add_argument("--title", required=True)
    d.add_argument("--source-name", help="what the map will say it was drawn from")
    f = sub.add_parser("drift", help="what a tool has that its map does not show, and the reverse")
    f.add_argument("spec")
    f.add_argument("kind", choices=["help", "make"])
    f.add_argument("source", help="a file, or - for standard input")
    k = sub.add_parser("stack", help="draw a Docker Compose stack from `docker compose config --format json`")
    k.add_argument("source", nargs="+",
                   help="the JSON, a file or - for standard input; several projects as LABEL=FILE, one after another")
    k.add_argument("-o", "--output")
    k.add_argument("--title")
    k.add_argument("--subtitle", default="The services, and how they connect")
    k.add_argument("--source-name", default="docker compose config")
    k.add_argument("--date", default="")
    args = ap.parse_args(argv)

    out = getattr(args, "output", None)
    if out and not Path(out).resolve().parent.is_dir():
        print(f"feature-map: no such directory for {out!r}", file=sys.stderr)
        return 2

    if args.cmd == "stack":
        projects = []
        for arg in args.source:
            label, path = arg.split("=", 1) if "=" in arg and not Path(arg).exists() else ("", arg)
            try:
                projects.append(read_compose(read_text(path), label or None))
            except REFUSED as exc:
                print(f"feature-map: {path}: {exc}", file=sys.stderr)
                return 1
            except OSError as exc:
                print(f"feature-map: {exc}", file=sys.stderr)
                return 2
        title = args.title or " + ".join(p["name"] for p in projects if p["name"]) or "Stack"
        try:
            body, w, h = stack_svg(projects, title, args.subtitle, args.source_name, args.date)
        except SpecError as exc:
            print(f"feature-map: {exc}", file=sys.stderr)
            return 1
        return write_output(body, w, h, title, args.output)

    if args.cmd == "draft":
        try:
            groups = read_source(args.kind, args.source)
        except UnicodeDecodeError as exc:
            print(f"feature-map: {args.source}: not UTF-8 text: {exc}", file=sys.stderr)
            return 1
        except OSError as exc:
            print(f"feature-map: {exc}", file=sys.stderr)
            return 2
        if not groups:
            print(f"feature-map: found no commands in that {args.kind} text", file=sys.stderr)
            return 1
        name = args.source_name or (f"its {args.kind} text" if args.source == "-" else f"{Path(args.source).name}")
        sys.stdout.write(draft(groups, args.title, name) + "\n")
        return 0

    try:
        spec = load(args.spec)
    except REFUSED as exc:
        print(f"feature-map: {args.spec}: {exc}", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"feature-map: {exc}", file=sys.stderr)
        return 2
    if args.cmd == "drift":
        try:
            groups = read_source(args.kind, args.source)
        except UnicodeDecodeError as exc:
            print(f"feature-map: {args.source}: not UTF-8 text: {exc}", file=sys.stderr)
            return 1
        except OSError as exc:
            print(f"feature-map: {exc}", file=sys.stderr)
            return 2
        missing, stale = drift(spec, groups)
        for n in missing:
            print(f"not on the map: {n}")
        for n in stale:
            print(f"on the map, not in the source: {n}")
        if missing or stale:
            print(f"feature-map: {spec['title']} has drifted: {len(missing)} not shown, {len(stale)} gone. "
                  "Add what is missing, or declare it with 'omit:'.", file=sys.stderr)
            return 1
        return 0
    if args.cmd == "check":
        items = sum(len(g["items"]) for g in spec["groups"])
        planned = sum(1 for g in spec["groups"] for i in g["items"] if g["planned"] or i.get("planned"))
        print(f"{spec['title']}: {len(spec['groups'])} groups, {items} items, {planned} not done yet; drawn from {spec['source']}")
        return 0
    fmt = args.format or (Path(args.output).suffix.lstrip(".") if args.output else "svg")
    if fmt not in ("svg", "html", "png", "mermaid", "mmd"):
        print(f"feature-map: cannot tell the format from {args.output!r}; pass --format", file=sys.stderr)
        return 2
    if fmt == "png":
        if not args.output:
            print("feature-map: png needs -o FILE", file=sys.stderr)
            return 2
        try:
            png(spec, args.output)
        except (RuntimeError, subprocess.TimeoutExpired) as exc:
            print(f"feature-map: {exc}", file=sys.stderr)
            return 3
        return 0
    text = {"svg": svg, "html": page, "mermaid": mermaid, "mmd": mermaid}[fmt](spec)
    if args.output:
        Path(args.output).write_text(text, encoding="utf-8")
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
